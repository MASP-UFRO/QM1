ed31dfb36cda"],

Cell[TextData[{
 StyleBox["\nCoeficientes de reflexi\[OAcute]n y transmisi\[OAcute]n.", 
  "Subsubsection"],
 "\n\nSi vemos al pozo de potencial como una \[OpenCurlyDoubleQuote]caja \
negra\[CloseCurlyDoubleQuote], nuestro mayor inter\[EAcute]s estar\[AAcute] \
en qu\[EAcute] es lo que emerge de \[EAcute]l cuando enviamos algo. As\
\[IAcute] suelen tratarse los problemas de ",
 StyleBox["scattering",
  FontSlant->"Italic"],
 ". \n\nEn este contexto, se envi\[OAcute] una onda desde ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{"-", "\[Infinity]"}]}], TraditionalForm]],ExpressionUUID->
  "51d0a444-84cb-4b6e-b633-515ffbe4d71e"],
 " hacia el pozo. Ah\[IAcute] puede ocurrir que una parte de esa onda se \
devuelva hacia la izquierda (reflexi\[OAcute]n) y que otra parte emerja hacia \
la derecha (transmisi\[OAcute]n). Las ",
 StyleBox["amplitudes de reflexi\[OAcute]n (\[ScriptR]) y transmisi\[OAcute]n \
(",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox["\[ScriptT]", TraditionalForm]],ExpressionUUID->
  "6dcbf676-0d61-4052-be57-4fcd64244d04"],
 StyleBox[")",
  FontSlant->"Italic"],
 " contienen informaci\[OAcute]n de con cu\[AAcute]nta probabilidad ocurrir\
\[AAcute] cada opci\[OAcute]n y si la onda gana alguna fase en ellas. \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{"\[ScriptR]", "=", 
     RowBox[{
      RowBox[{
       FractionBox[
        SubscriptBox["B", "1"], 
        SubscriptBox["A", "1"]], " \t", 
       StyleBox["y",
        FontSlant->"Plain"], " \t", "\[ScriptT]"}], "=", 
      RowBox[{
       FractionBox[
        SubscriptBox["A", "3"], 
        SubscriptBox["A", "1"]], "."}]}]}]}], TraditionalForm]],
  ExpressionUUID->"cdc10647-7042-4430-83da-80469e4b4ff2"],
 "\n\nEn este c\[AAcute]lculo se muestran estos coeficientes ",
 StyleBox["bajo la suposici\[OAcute]n",
  FontSlant->"Italic"],
 " de que la onda incidente viene desde la izquierda. \nSi se hubiera \
supuesto que la onda viene desde la derecha, se debe calcular ",
 Cell[BoxData[
  FormBox["\[ScriptR]", TraditionalForm]],ExpressionUUID->
  "6d7920fe-db00-4435-b091-efa58f48f08d"],
 " y ",
 Cell[BoxData[
  FormBox["\[ScriptT]", TraditionalForm]],ExpressionUUID->
  "3c588b03-1e06-4046-8f2a-b7b79a32f884"],
 " de acuerdo con ese convenio. \n\n \t\[FilledSmallCircle] Suponga que ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptR]", "\[PlusMinus]"], TraditionalForm]],
  ExpressionUUID->"d2d8e1dc-427f-448d-aa3e-03c7ab8508d7"],
 " y ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptT]", "\[PlusMinus]"], TraditionalForm]],
  ExpressionUUID->"117f923e-0fb2-487a-97eb-d111e503a0c4"],
 " fuesen las amplitudes de reflexi\[OAcute]n y transmisi\[OAcute]n para una \
onda que va desde ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[MinusPlus]", "\[Infinity]"}], TraditionalForm]],ExpressionUUID->
  "abfc516e-b7b7-4018-9208-7e9d0b5da460"],
 " hacia ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[PlusMinus]", "\[Infinity]"}], TraditionalForm]],ExpressionUUID->
  "70f0f920-ff5c-4471-9ea8-4d0c6e41786e"],
 ". \n \t\t\[EmptySmallCircle] El signo en el sub\[IAcute]ndice indica la ",
 StyleBox["direcci\[OAcute]n de propagaci\[OAcute]n",
  FontVariations->{"Underline"->True}],
 " de la onda incidente, no su procedencia. \n \t\t\[EmptySmallCircle] Los ",
 Cell[BoxData[
  FormBox["\[ScriptR]", TraditionalForm]],ExpressionUUID->
  "a32bdc6f-02a2-45c4-be35-8d9a1aabb935"],
 " y ",
 Cell[BoxData[
  FormBox["\[ScriptT]", TraditionalForm]],ExpressionUUID->
  "8816cf9a-7a62-43c1-862c-41affda4a56b"],
 " de m\[AAcute]s arriba ser\[IAcute]an como estos ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptR]", "+"], TraditionalForm]],ExpressionUUID->
  "0192bbb1-7e75-46c2-af8c-a56f32635c02"],
 " y ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptT]", "+"], TraditionalForm]],ExpressionUUID->
  "48c03aaf-3e3b-4027-8607-a283b834410a"],
 ", respectivamente. \n \t\[FilledSmallCircle] ",
 StyleBox["Generalmente",
  FontWeight->"Bold"],
 " ocurrir\[AAcute] que ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     SubscriptBox["\[ScriptR]", "+"], "\[NotEqual]", 
     RowBox[{
      SubscriptBox["\[ScriptR]", "-"], " \t", 
      StyleBox["y",
       FontSlant->"Plain"], " \t", 
      SubscriptBox["\[ScriptT]", "+"]}], "\[NotEqual]", 
     SubscriptBox["\[ScriptT]", "-"]}]}], TraditionalForm]],ExpressionUUID->
  "8685630b-0a86-48de-9777-19c6300b57bb"],
 ".\n \t\[FilledSmallCircle] No obstante, potenciales sim\[EAcute]tricos como \
el que estamos viendo aqu\[IAcute] s\[IAcute] exhiben igualdad.\n\t\nLuego, \
las probabilidades de que la part\[IAcute]cula termine siendo reflejada o \
transmitida se calculan como solemos hacerlo en Mec\[AAcute]nica \
Cu\[AAcute]ntica: m\[OAcute]dulo al cuadrado de las amplitudes.\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{"R", "=", 
      RowBox[{"\[VerticalSeparator]", "\[ScriptR]", 
       SuperscriptBox["\[VerticalSeparator]", "2"]}]}], ",", " \t", 
     RowBox[{
      RowBox[{
       StyleBox["y",
        FontSlant->"Plain"], " \t", "T"}], "=", 
      RowBox[{"\[VerticalSeparator]", "\[ScriptT]", 
       SuperscriptBox["\[VerticalSeparator]", "2"], "."}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"2719eb5e-297d-4ab4-aca8-f15fe5136e1f"],
 " \t\n\n\n",
 StyleBox["* Para ver los gr\[AAcute]ficos interactivos, ejecute la siguiente \
celda y vaya al final del archivo. ",
  FontSlant->"Italic"],
 "\n"
}], "Text",
 CellChangeTimes->{
  4.0010760175347443`*^9, {4.0010760839447002`*^9, 4.001076546514537*^9}, {
   4.001076639264883*^9, 4.001076687616231*^9}, {4.001076733868971*^9, 
   4.001076792454417*^9}, {4.001076822609432*^9, 4.001076845461174*^9}, {
   4.001076879408512*^9, 4.0010775091694613`*^9}, {4.001080050499467*^9, 
   4.001080073271845*^9}, {4.001080189026396*^9, 4.0010802308808603`*^9}, 
   4.001783538957652*^9, {4.001800782936943*^9, 
   4.0018008077181664`*^9}},ExpressionUUID->"b6e8c787-bb25-42ac-ab3a-\
3bdc0eacfdf3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$Assumptions", "=", 
     RowBox[{
      RowBox[{"And", "@@", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["k", "in"], ",", 
           SubscriptBox["k", "out"], ",", 
           SubscriptBox["\[CapitalKappa]", "P"], ",", 
           SubscriptBox["\[Gamma]", "in"], ",", 
           SubscriptBox["\[Gamma]", "out"], ",", "L", ",", 
           "\[ScriptCapitalL]", ",", "\[CapitalLambda]", ",", 
           SubscriptBox["\[Lambda]", "P"], ",", 
           SubscriptBox["\[Lambda]", "dB"], ",", "m", ",", "\[HBar]", ",", 
           "\[ScriptCapitalE]", ",", "\[Eta]", ",", 
           SubscriptBox["V", "in"], ",", 
           SubscriptBox["V", "out"], ",", "\[CapitalDelta]V", ",", 
           "\[CapitalDelta]\[ScriptCapitalV]", ",", 
           OverscriptBox["\[ScriptCapitalA]", "\[EmptySmallCircle]"], ",", 
           "\[ScriptM]", ",", "\[ScriptS]", ",", 
           "\[ScriptE]\[ScriptCapitalV]"}], "}"}], ">", "0"}], "]"}]}], "&&", 
      
      RowBox[{"\[CapitalDelta]\[ScriptCapitalE]", ">", "0"}], "&&", 
      RowBox[{"\[Eta]", "\[GreaterEqual]", "1"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Funciones", " ", "de", " ", "onda", " ", 
     RowBox[{"posibles", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["\[Psi]", "j_"], "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       SubscriptBox["A", "j"], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["\[Kappa]", "j"], "x"}]]}], "+", 
      RowBox[{
       SubscriptBox["B", "j"], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         SubscriptBox["\[Kappa]", "j"], "x"}]]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Reducci\[OAcute]n", " ", "de", " ", 
     RowBox[{"par\[AAcute]metros", "."}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"\[CapitalDelta]V", " ", "=", " ", 
      RowBox[{
       SubscriptBox["V", "out"], " ", "-", " ", 
       SubscriptBox["V", "in"]}]}], ",", " ", 
     RowBox[{"\"\<profundidad\>\"", " ", "del", " ", 
      RowBox[{"pozo", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Reduccion", "=", 
     RowBox[{"{", "\[IndentingNewLine]", "\t", 
      RowBox[{
       RowBox[{
        SubscriptBox["k", "in"], "\[Rule]", 
        SqrtBox[
         RowBox[{
          FractionBox[
           RowBox[{"2", "m"}], 
           SuperscriptBox["\[HBar]", "2"]], 
          RowBox[{"(", 
           RowBox[{"\[ScriptCapitalE]", "-", 
            SubscriptBox["V", "in"]}], ")"}]}]]}], ",", "\[IndentingNewLine]",
        "\t", 
       RowBox[{
        SubscriptBox["k", "out"], "\[Rule]", 
        SqrtBox[
         RowBox[{
          FractionBox[
           RowBox[{"2", "m"}], 
           SuperscriptBox["\[HBar]", "2"]], 
          RowBox[{"(", 
           RowBox[{"\[ScriptCapitalE]", "-", 
            SubscriptBox["V", "out"]}], ")"}]}]]}], ",", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{
        SubscriptBox["\[Gamma]", "in"], "\[Rule]", 
        SqrtBox[
         RowBox[{
          FractionBox[
           RowBox[{"2", "m"}], 
           SuperscriptBox["\[HBar]", "2"]], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["V", "in"], "-", "\[ScriptCapitalE]"}], ")"}]}]]}], ",",
        "\[IndentingNewLine]", "\t", 
       RowBox[{
        SubscriptBox["\[Gamma]", "out"], "\[Rule]", 
        SqrtBox[
         RowBox[{
          FractionBox[
           RowBox[{"2", "m"}], 
           SuperscriptBox["\[HBar]", "2"]], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["V", "out"], "-", "\[ScriptCapitalE]"}], ")"}]}]]}], 
       ",", "\[IndentingNewLine]", "\t", 
       RowBox[{"\[ScriptCapitalE]", "\[Rule]", 
        RowBox[{"\[CapitalDelta]\[ScriptCapitalE]", "+", 
         SubscriptBox["V", "in"]}]}], ",", "\[IndentingNewLine]", "\t", 
       RowBox[{
        SubscriptBox["V", "out"], "\[Rule]", 
        RowBox[{"\[CapitalDelta]V", "+", 
         SubscriptBox["V", "in"]}]}], ",", "\[IndentingNewLine]", "\t", 
       RowBox[{"\[CapitalDelta]\[ScriptCapitalE]", "\[Rule]", 
        RowBox[{"\[Eta]", " ", "\[CapitalDelta]V"}]}], ",", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{
        SubscriptBox["\[Lambda]", "dB"], "\[Rule]", 
        SqrtBox[
         FractionBox[
          RowBox[{"2", 
           SuperscriptBox["\[Pi]", "2"], 
           SuperscriptBox["\[HBar]", "2"]}], 
          RowBox[{"m", " ", "\[CapitalDelta]\[ScriptCapitalE]"}]]]}], ",", 
       "\[IndentingNewLine]", "\t", 
       RowBox[{"L", "\[Rule]", 
        RowBox[{"\[CapitalLambda]", " ", 
         SubscriptBox["\[Lambda]", "dB"]}]}]}], "\t\t", "\[IndentingNewLine]",
       "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
   "(*", "\"\<\nPara gr\[AAcute]ficos, consideremos un electr\[OAcute]n en un \
pozo que tiene unos cuantos \[ARing]rmstr\[ODoubleDot]ng de ancho y unos \
cuantos electronvolts de profundidad. Podemos ir cambiando L y \
\[CapitalDelta]V.\n\>\"", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Numeros", "=", 
     RowBox[{"{", "\[IndentingNewLine]", "\t\t", 
      RowBox[{
       RowBox[{
        SubscriptBox["k", "in"], "\[Rule]", 
        SqrtBox[
         RowBox[{
          FractionBox[
           RowBox[{"2", "m"}], 
           SuperscriptBox["\[HBar]", "2"]], 
          RowBox[{"(", 
           RowBox[{"\[ScriptCapitalE]", "-", 
            SubscriptBox["V", "in"]}], ")"}]}]]}], ",", "\[IndentingNewLine]",
        "\t\t", 
       RowBox[{
        SubscriptBox["k", "out"], "\[Rule]", 
        SqrtBox[
         RowBox[{
          FractionBox[
           RowBox[{"2", "m"}], 
           SuperscriptBox["\[HBar]", "2"]], 
          RowBox[{"(", 
           RowBox[{"\[ScriptCapitalE]", "-", 
            SubscriptBox["V", "out"]}], ")"}]}]]}], ",", 
       "\[IndentingNewLine]", "\t\t", 
       RowBox[{
        SubscriptBox["\[Gamma]", "in"], "\[Rule]", 
        SqrtBox[
         RowBox[{
          FractionBox[
           RowBox[{"2", "m"}], 
           SuperscriptBox["\[HBar]", "2"]], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["V", "in"], "-", "\[ScriptCapitalE]"}], ")"}]}]]}], ",",
        "\[IndentingNewLine]", "\t\t", 
       RowBox[{
        SubscriptBox["\[Gamma]", "out"], "\[Rule]", 
        SqrtBox[
         RowBox[{
          FractionBox[
           RowBox[{"2", "m"}], 
           SuperscriptBox["\[HBar]", "2"]], 
          RowBox[{"(", 
           RowBox[{
            SubscriptBox["V", "out"], "-", "\[ScriptCapitalE]"}], ")"}]}]]}], 
       ",", "\[IndentingNewLine]", "\t\t", 
       RowBox[{
        SubscriptBox["\[Lambda]", "dB"], "\[Rule]", 
        SqrtBox[
         FractionBox[
          RowBox[{"2", 
           SuperscriptBox["\[Pi]", "2"], 
           SuperscriptBox["\[HBar]", "2"]}], 
          RowBox[{"m", " ", "\[CapitalDelta]\[ScriptCapitalE]"}]]]}], ",", 
       "\[IndentingNewLine]", "\t\t", 
       RowBox[{"\[ScriptCapitalE]", "\[Rule]", 
        RowBox[{"\[CapitalDelta]\[ScriptCapitalE]", "+", 
         SubscriptBox["V", "in"]}]}], ",", "\[IndentingNewLine]", "\t\t", 
       RowBox[{
        SubscriptBox["V", "out"], "\[Rule]", 
        RowBox[{"\[CapitalDelta]V", "+", 
         SubscriptBox["V", "in"]}]}], ",", "\[IndentingNewLine]", "\t\t", 
       RowBox[{"\[CapitalDelta]\[ScriptCapitalE]", "\[Rule]", 
        RowBox[{"\[Eta]", " ", "\[CapitalDelta]V"}]}], ",", 
       "\[IndentingNewLine]", "\t\t", 
       RowBox[{"c", "\[Rule]", 
        RowBox[{"299792458", " ", 
         RowBox[{"\[ScriptM]", "/", "\[ScriptS]"}]}]}], ",", 
       "\[IndentingNewLine]", "\t\t", 
       RowBox[{"\[HBar]", "\[Rule]", 
        RowBox[{
         FractionBox["6.62607015", 
          RowBox[{"2", "\[Pi]"}]], "\[Times]", 
         SuperscriptBox["10", 
          RowBox[{"-", "34"}]], "\[ScriptCapitalJ]", " ", "\[ScriptS]"}]}], ",",
        "\[IndentingNewLine]", "\t\t", 
       RowBox[{"\[ScriptCapitalJ]", "\[Rule]", 
        FractionBox["\[ScriptE]\[ScriptCapitalV]", 
         RowBox[{"1.60217663", "\[Times]", 
          SuperscriptBox["10", 
           RowBox[{"-", "19"}]]}]]}], ",", "\[IndentingNewLine]", "\t\t", 
       RowBox[{"m", "\[Rule]", 
        RowBox[{"0.511", " ", "\[Times]", 
         SuperscriptBox["10", "6"], " ", 
         RowBox[{"\[ScriptE]\[ScriptCapitalV]", "/", 
          SuperscriptBox["c", "2"]}]}]}], ",", "\[IndentingNewLine]", "\t\t", 
       
       RowBox[{"\[ScriptM]", "\[Rule]", 
        FractionBox[
         OverscriptBox["\[ScriptCapitalA]", "\[EmptySmallCircle]"], 
         SuperscriptBox["10", 
          RowBox[{"-", "10"}]]]}], ",", "\[IndentingNewLine]", "\t\t", 
       RowBox[{"L", "\[Rule]", 
        RowBox[{"\[ScriptCapitalL]", " ", 
         OverscriptBox["\[ScriptCapitalA]", "\[EmptySmallCircle]"]}]}], ",", 
       "                                       ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"\[ScriptCapitalL]", ":", " ", 
          RowBox[{"Ancho", " ", "del", " ", "pozo"}]}], ",", " ", 
         RowBox[{"pero", " ", "medido", " ", "en", " ", 
          RowBox[{"\[ARing]rmstr\[ODoubleDot]ngs", "."}]}]}], " ", "*)"}], 
       "\[IndentingNewLine]", "\t\t", 
       RowBox[{"\[CapitalDelta]V", "\[Rule]", 
        RowBox[{
        "\[CapitalDelta]\[ScriptCapitalV]", " ", 
         "\[ScriptE]\[ScriptCapitalV]"}]}], ",", "\t\t             ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"\[CapitalDelta]\[ScriptCapitalV]", ":", " ", 
          RowBox[{"profundidad", " ", "del", " ", "pozo"}]}], ",", " ", 
         RowBox[{"pero", " ", "medido", " ", "en", " ", 
          RowBox[{"electronvolts", "."}]}]}], " ", "*)"}], 
       "\[IndentingNewLine]", "\t\t", 
       RowBox[{"\[Sigma]", "\[Rule]", "5"}]}], 
      "                                       ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"\[Sigma]", ":", " ", 
         RowBox[{
         "ancho", " ", "del", " ", "paquete", " ", "de", " ", "onda"}]}], ",",
         " ", 
        RowBox[{"en", " ", 
         RowBox[{"\[ARing]rmstr\[ODoubleDot]ngs", "."}]}]}], " ", "*)"}], 
      "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Funciones", " ", "solo", " ", "para", " ", "ayudar", " ", "en", " ", 
     "la", " ", "presentaci\[OAcute]n", " ", "de", " ", 
     RowBox[{"resultados", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TsT", "[", "args__", "]"}], ":=", 
    RowBox[{"TraditionalForm", "[", 
     RowBox[{"StringRiffle", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ToString", "[", 
         RowBox[{"#", ",", "TraditionalForm"}], "]"}], "&"}], "/@", 
       RowBox[{"{", "args", "}"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Condiciones", " ", "de", " ", 
     RowBox[{"continuidad", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Continuidad", "=", 
     RowBox[{"{", "\[IndentingNewLine]", "\t\t\t", 
      RowBox[{
       RowBox[{
        RowBox[{
         SubscriptBox["\[Psi]", "1"], "[", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], "]"}], "\[Equal]", 
        RowBox[{
         SubscriptBox["\[Psi]", "2"], "[", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], "]"}]}], ",", "\[IndentingNewLine]",
        "\t\t\t", 
       RowBox[{
        RowBox[{
         RowBox[{
          SubscriptBox["\[Psi]", "1"], "'"}], "[", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Psi]", "2"], "'"}], "[", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], "]"}]}], ",", "\[IndentingNewLine]",
        "\t\t\t", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[Psi]", "2"], "[", 
         RowBox[{"L", "/", "2"}], "]"}], "\[Equal]", 
        RowBox[{
         SubscriptBox["\[Psi]", "3"], "[", 
         RowBox[{"L", "/", "2"}], "]"}]}], ",", "\[IndentingNewLine]", 
       "\t\t\t", 
       RowBox[{
        RowBox[{
         RowBox[{
          SubscriptBox["\[Psi]", "2"], "'"}], "[", 
         RowBox[{"L", "/", "2"}], "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{
          SubscriptBox["\[Psi]", "3"], "'"}], "[", 
         RowBox[{"L", "/", "2"}], "]"}]}]}], "\[IndentingNewLine]", "\t\t\t", 
      "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SubsA", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Kappa]", "1"], "\[Rule]", 
        SubscriptBox["k", "out"]}], ",", 
       RowBox[{
        SubscriptBox["\[Kappa]", "2"], "\[Rule]", 
        SubscriptBox["k", "in"]}], ",", 
       RowBox[{
        SubscriptBox["\[Kappa]", "3"], "\[Rule]", 
        SubscriptBox["k", "out"]}], ",", 
       RowBox[{
        SubscriptBox["B", "3"], "\[Rule]", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     SubscriptBox["Eqs", "a"], "=", 
     RowBox[{"Continuidad", "//.", "SubsA"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{
     SubscriptBox["v", "a"], "=", 
     RowBox[{"{", 
