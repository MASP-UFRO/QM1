  ExpressionUUID->"a0ae7780-a22e-432d-b25d-7d241c7bbaa9"],
 "\n\nPara cada regi\[OAcute]n indicada en la figura tendremos una ESIT de la \
forma \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox["\[HBar]", "2"], 
          RowBox[{"2", "m"}]]}], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[DifferentialD]", "2"], 
          SubscriptBox["\[Psi]", "j"]}], 
         RowBox[{"\[DifferentialD]", 
          SuperscriptBox["x", "2"]}]]}], "+", 
       RowBox[{
        SubscriptBox["V", "j"], 
        SubscriptBox["\[Psi]", "j"]}]}], "=", " ", 
      RowBox[{"\[ScriptCapitalE]", " ", 
       SubscriptBox["\[Psi]", "j"]}]}], ",", " \t", 
     RowBox[{
      RowBox[{"donde", " \t", "j"}], "=", "1"}], ",", "2", ",", "3", ",", 
     " \t", 
     RowBox[{
      SubscriptBox["V", "1"], "=", 
      RowBox[{
       SubscriptBox["V", "3"], "=", 
       RowBox[{
        RowBox[{
         SubscriptBox["V", "out"], " \t", 
         StyleBox["y",
          FontSlant->"Plain"], "\t", 
         SubscriptBox["V", "2"]}], "=", 
        RowBox[{
         SubscriptBox["V", "in"], "."}]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"9969712d-2c0c-4787-92ab-7fd72d184545"],
 "\n\nEstas ecuaciones son equivalentes a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        SubsuperscriptBox["\[Psi]", "j", "\[DoublePrime]"], "(", "x", ")"}], "+", 
       RowBox[{
        SubsuperscriptBox["k", "j", "2"], 
        RowBox[{
         SubscriptBox["\[Psi]", "j"], "(", "x", ")"}]}]}], "=", "0"}], ",", 
     "\t", 
     RowBox[{"donde", "\t", GridBox[{
        {
         SubscriptBox["k", "1"], "=", 
         SqrtBox[
          RowBox[{
           FractionBox[
            RowBox[{"2", "m"}], 
            SuperscriptBox["\[HBar]", "2"]], 
           RowBox[{"(", 
            RowBox[{"\[ScriptCapitalE]", "-", 
             SubscriptBox["V", "out"]}], ")"}]}]], "=", 
         RowBox[{
          SubscriptBox["k", "out"], ","}]},
        {
         SubscriptBox["k", "2"], "=", 
         SqrtBox[
          RowBox[{
           FractionBox[
            RowBox[{"2", "m"}], 
            SuperscriptBox["\[HBar]", "2"]], 
           RowBox[{"(", 
            RowBox[{"\[ScriptCapitalE]", "-", 
             SubscriptBox["V", "in"]}], ")"}]}]], "=", 
         RowBox[{
          SubscriptBox["k", "in"], ","}]},
        {
         SubscriptBox["k", "3"], "=", 
         SqrtBox[
          RowBox[{
           FractionBox[
            RowBox[{"2", "m"}], 
            SuperscriptBox["\[HBar]", "2"]], 
           RowBox[{"(", 
            RowBox[{"\[ScriptCapitalE]", "-", 
             SubscriptBox["V", "out"]}], ")"}]}]], "=", 
         RowBox[{
          SubscriptBox["k", "out"], "."}]}
       }]}]}]}], TraditionalForm]],ExpressionUUID->
  "3f78c722-c90a-491e-ac75-b6d5aa0979c1"],
 " \n\nLas soluciones para cada regi\[OAcute]n ser\[AAcute]n de la forma ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[Psi]", "j"], "(", "x", ")"}], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["A", "j"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          SubscriptBox["k", "j"], "x"}]]}], " ", "+", " ", 
       RowBox[{
        SubscriptBox["B", "j"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          SubscriptBox["k", "j"], "x"}]]}]}]}], ",", "\t"}]}], 
   TraditionalForm]],ExpressionUUID->"9a76f62e-00a2-40a8-be74-83252badb5f5"],
 "donde los coeficientes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "j"], TraditionalForm]],ExpressionUUID->
  "c474cbae-e532-4984-8d70-5b257cd03ada"],
 " y ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "j"], TraditionalForm]],ExpressionUUID->
  "ef0072f6-9dd7-445d-9513-2fa290a7e4b3"],
 " son inc\[OAcute]gnitas a determinar. \n\nPara simplificar la descripci\
\[OAcute]n, hay algunos par\[AAcute]metros auxiliares que usaremos en \
ocasiones: \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", GridBox[{
      {"\[CapitalDelta]V", "=", 
       RowBox[{
        SubscriptBox["V", "out"], "-", 
        SubscriptBox["V", "in"]}], ":", 
       RowBox[{"\"\<profundidad\>\"", " ", "del", " ", 
        RowBox[{"pozo", ".", "    \t\t\t\t\t\t\t\t\t\t"}]}]},
      {"\[CapitalDelta]\[ScriptCapitalE]", "=", 
       RowBox[{"\[ScriptCapitalE]", "-", 
        SubscriptBox["V", "in"]}], ":", 
       RowBox[{
       "indica", " ", "cu\[AAcute]nto", " ", "sobresale", " ", "la", " ", 
        "energ\[IAcute]a", " ", "\[ScriptCapitalE]", " ", "por", " ", 
        "encima", " ", "del", " ", "fondo", " ", "del", " ", 
        RowBox[{"pozo", ".", "           \t"}]}]},
      {"\[Eta]", "=", 
       RowBox[{"\[CapitalDelta]\[ScriptCapitalE]", "/", "\[CapitalDelta]V"}], 
       ":", 
       RowBox[{
       "ubicaci\[OAcute]n", " ", "de", " ", "la", " ", "energ\[IAcute]a", " ",
         "\[ScriptCapitalE]", " ", "relativa", " \[VeryThinSpace]", 
        StyleBox["a",
         FontSlant->"Plain"], " ", "la", " ", "profundidad", " ", "del", " ", 
        
        RowBox[{"pozo", ".", "     \t\t\t"}]}]},
      {" ", " ", " ", " ", 
       RowBox[{
        RowBox[{"Por", " ", "ejemplo"}], ",", " ", 
        RowBox[{"\[Eta]", "=", 
         RowBox[{
          FractionBox["1", "2"], " ", "indica", " ", "que", " ", 
          "\[ScriptCapitalE]", "  ", "est\[AAcute]", " ", "exactamente", " ", 
          
          StyleBox["a",
           FontSlant->"Plain"], " ", "la", " ", "mitad", " ", "entre", " ", 
          SubscriptBox["V", "in"], " ", 
          StyleBox["y",
           FontSlant->"Plain"], " ", 
          RowBox[{
           SubscriptBox["V", "out"], ".", "    "}]}]}]}]},
      {
       SubscriptBox["\[Lambda]", "dB"], "=", 
       SqrtBox[
        FractionBox[
         RowBox[{"2", 
          SuperscriptBox["\[Pi]", "2"], 
          SuperscriptBox["\[HBar]", "2"]}], 
         RowBox[{"m", " ", "\[CapitalDelta]\[ScriptCapitalE]"}]]], ":", 
       RowBox[{
        RowBox[{
        "longitud", " ", "de", " ", "onda", " ", "de", " ", "de", " ", 
         "Broglie", " ", "de", " ", "la", " ", "part\[IAcute]cula"}], ",", 
        " ", 
        RowBox[{
        "tomando", " ", "\[CapitalDelta]\[ScriptCapitalE]", " ", "como", " ", 
         
         RowBox[{"referencia", "."}]}]}]},
      {" ", " ", " ", " ", 
       RowBox[{
       "\[FilledSmallCircle]", "  ", "Imagine", " ", "que", " ", "la", " ", 
        "energ\[IAcute]a", " ", "cin\[EAcute]tica", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["p", "2"], "/", "2"}], "m"}], ")"}], " ", "de", " ",
         "la", " ", "part\[IAcute]cula", " ", "fuese", " ", 
        RowBox[{"\[CapitalDelta]\[ScriptCapitalE]", "."}]}]},
      {" ", " ", " ", " ", 
       RowBox[{
        RowBox[{"\[FilledSmallCircle]", " ", "Entonces"}], ",", " ", 
        RowBox[{"p", "=", 
         RowBox[{
          SqrtBox[
           RowBox[{"2", "m", " ", "\[CapitalDelta]\[ScriptCapitalE]"}]], ".", 
          "            \t\t\t\t\t\t\t"}]}]}]},
      {" ", " ", " ", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
         "\[FilledSmallCircle]", " ", "La", " ", "hip\[OAcute]tesis", " ", 
          "de", " ", "de", " ", "Broglie", " ", "dice", " ", "que", " ", 
          "p"}], "=", 
         RowBox[{"\[HBar]", "\[VeryThinSpace]", "k"}]}], ",", " ", 
        RowBox[{
         RowBox[{"donde", " ", "k"}], "=", 
         RowBox[{"2", 
          RowBox[{"\[Pi]", "/", 
           RowBox[{
            SubscriptBox["\[Lambda]", "dB"], ".", "         "}]}]}]}]}]},
      {" ", " ", " ", " ", 
       RowBox[{
        RowBox[{"\[FilledSmallCircle]", " ", "Despejando"}], ",", " ", 
        RowBox[{
         RowBox[{"se", " ", "obtiene", " ", "que", " ", 
          SubscriptBox["\[Lambda]", "dB"]}], "=", 
         RowBox[{
          SqrtBox[
           FractionBox[
            RowBox[{"2", 
             SuperscriptBox["\[Pi]", "2"], 
             SuperscriptBox["\[HBar]", "2"]}], 
            RowBox[{"m", " ", "\[CapitalDelta]\[ScriptCapitalE]"}]]], ".", 
          "    \t\t\t\t"}]}]}]},
      {"\[CapitalLambda]", "=", 
       RowBox[{"L", "/", 
        SubscriptBox["\[Lambda]", "dB"]}], ":", 
       RowBox[{
        RowBox[{"ancho", " ", "del", " ", "pozo"}], ",", " ", 
        RowBox[{
        "pero", " ", "expresado", " ", "en", " ", "m\[UAcute]ltiplos", " ", 
         "de", " ", 
         RowBox[{
          SubscriptBox["\[Lambda]", "dB"], ".", "       \t\t\t\t   "}]}]}]}
     }], "\t"}], TraditionalForm]],ExpressionUUID->
  "a0ce33de-1937-44c7-8b7c-5f7def33edd3"],
 "\n\nCon estas sustituciones, podemos escribir tambi\[EAcute]n que",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", GridBox[{
      {
       SubscriptBox["k", "in"], "=", 
       SqrtBox[
        RowBox[{
         FractionBox[
          RowBox[{"2", "m"}], 
          SuperscriptBox["\[HBar]", "2"]], 
         "\[CapitalDelta]\[ScriptCapitalE]"}]], "=", 
       RowBox[{
        SqrtBox[
         FractionBox[
          RowBox[{"2", "m", " ", "\[CapitalDelta]V"}], 
          SuperscriptBox["\[HBar]", "2"]]], 
        SqrtBox["\[Eta]"]}], ","},
      {
       SubscriptBox["k", "out"], "=", 
       SqrtBox[
        RowBox[{
         FractionBox[
          RowBox[{"2", "m"}], 
          SuperscriptBox["\[HBar]", "2"]], 
         RowBox[{"(", 
          RowBox[{
          "\[CapitalDelta]\[ScriptCapitalE]", "-", "\[CapitalDelta]V"}], 
          ")"}]}]], "=", 
       RowBox[{
        SqrtBox[
         FractionBox[
          RowBox[{"2", "m", " ", "\[CapitalDelta]V"}], 
          SuperscriptBox["\[HBar]", "2"]]], 
        SqrtBox[
         RowBox[{"\[Eta]", "-", "1"}]]}], ","},
      {"\[CapitalLambda]", "=", 
       RowBox[{"L", 
        SqrtBox[
         RowBox[{
          FractionBox["m", 
           RowBox[{"2", 
            SuperscriptBox["\[Pi]", "2"], 
            SuperscriptBox["\[HBar]", "2"]}]], 
          "\[CapitalDelta]\[ScriptCapitalE]"}]]}], "=", 
       RowBox[{
        FractionBox["L", 
         RowBox[{"2", "\[Pi]"}]], 
        SqrtBox[
         FractionBox[
          RowBox[{"2", "m", " ", "\[CapitalDelta]V"}], 
          SuperscriptBox["\[HBar]", "2"]]], 
        SqrtBox["\[Eta]"]}], "."}
     }], "\t"}], TraditionalForm]],ExpressionUUID->
  "0c3645d3-d666-4267-8794-4c76a5c2576e"]
}], "Text",
 CellChangeTimes->{{4.0010632162920933`*^9, 4.0010634229275723`*^9}, {
   4.001063647155232*^9, 4.001063659572411*^9}, {4.0010642153652687`*^9, 
   4.00106422376053*^9}, {4.001064650649377*^9, 4.0010646925429287`*^9}, {
