   4.002296650124215*^9},ExpressionUUID->"1859a427-9961-4345-9f5c-\
c8afe6838f9f"],

Cell[TextData[{
 "\n",
 StyleBox["Caso (a): ", "Subsection"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptCapitalE]", ">", 
    SubscriptBox["V", "out"], ">", 
    SubscriptBox["V", "in"]}], TraditionalForm]], "Subsection",
  FontWeight->"Plain",ExpressionUUID->"cf8dcefa-92cc-4fc2-b6c7-dde7d14b1026"],
   "Subsection"],
 "\n\nEn las tres regiones tendremos soluciones oscilatorias, pues todos los ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "j"], TraditionalForm]],ExpressionUUID->
  "e2f5c0d2-e22f-4b9d-8355-74773790d879"],
 " son reales y positivos. As\[IAcute] que no tenemos confinamiento en este r\
\[EAcute]gimen. \nDebido a ello, podemos suponer que la part\[IAcute]cula \
viene desde lejos como, por ejemplo, desde ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{"-", "\[Infinity]"}]}], TraditionalForm]],ExpressionUUID->
  "17329695-7753-478c-b57c-47260848c626"],
 ". Entonces, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "1"], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "55bfdcc4-d043-454d-9351-9453b265fd0c"],
 StyleBox[" ser\[AAcute] el coeficiente de referencia",
  FontSlant->"Italic"],
 " ya que indica la amplitud de la onda incidente. \n\nLa onda no tiene con \
qu\[EAcute] reflejarse en la Regi\[OAcute]n 3, as\[IAcute] que es de esperar \
que ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["B", "3"], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "bcb0d91e-023c-442c-a3d0-d29f6160d041"],
 ". \nCon ello, las condiciones de continuidad constuyen un sistema no homog\
\[EAcute]neo de 4 ecuaciones lineales para las inc\[OAcute]gnitas ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["B", "1"], ",", 
    SubscriptBox["A", "2"], ",", 
    SubscriptBox["B", "2"]}], TraditionalForm]],ExpressionUUID->
  "8e2e2fb3-f026-4932-a9c1-2a6ea6a3f694"],
 " y ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "3"], TraditionalForm]],ExpressionUUID->
  "13ea5336-265f-43a2-97d0-37829f68e0dc"],
 ", que ser\[AAcute]n expresadas en funci\[OAcute]n de ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "1"], TraditionalForm]],ExpressionUUID->
  "621b53f0-6951-498c-b8eb-5aa27113170c"],
 ": \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", GridBox[{
      {
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["A", "2"]}], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], " ", "-", " ", 
        RowBox[{
         SubscriptBox["B", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], " ", "+", " ", 
        RowBox[{
         SubscriptBox["B", "1"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}]}], "=", 
       RowBox[{
        SubscriptBox["A", "1"], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
          SubscriptBox["k", "out"]}]]}]},
      {
       RowBox[{
        RowBox[{"-", 
         RowBox[{"\[ImaginaryI]", " ", 
          SubscriptBox["A", "2"], " ", 
          SubscriptBox["k", "in"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
            SubscriptBox["k", "in"]}]]}]}], " ", "+", " ", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["B", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], " ", "-", " ", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["B", "1"], " ", 
         SubscriptBox["k", "out"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}]}], "=", 
       RowBox[{"\[ImaginaryI]", " ", 
        SubscriptBox["A", "1"], " ", 
        SubscriptBox["k", "out"], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
          SubscriptBox["k", "out"]}]]}]},
      {
       RowBox[{
        RowBox[{
         SubscriptBox["A", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], " ", "-", " ", 
        RowBox[{
         SubscriptBox["A", "3"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}], " ", "+", " ", 
        RowBox[{
         SubscriptBox["B", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}], "=", "0"},
      {
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["A", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], " ", "-", " ", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["A", "3"], " ", 
         SubscriptBox["k", "out"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}], " ", "-", " ", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["B", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}], "=", "0"}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}]}], TraditionalForm]],ExpressionUUID->
  "30dc602c-1841-4524-8dca-e5185e11d29f"],
 "\n\nEste sistema se puede representar matricialmente como  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       StyleBox["M",
        FontWeight->"Bold"], "\[CenterDot]", 
       OverscriptBox["v", "\[RightVector]"]}], "=", 
      OverscriptBox["b", "\[RightVector]"]}], ",", "\t"}]}], 
   TraditionalForm]],ExpressionUUID->"61caf34c-891d-4b89-b2a2-fa5e126e5cf7"],
 " donde:\[LineSeparator]\n  \t\[FilledSmallCircle] ",
 Cell[BoxData[
  FormBox[
   StyleBox["M",
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "f2c388c0-1b31-4b45-b42f-5d6bb67fc1c8"],
 " es la matriz de coeficientes, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["M",
     FontWeight->"Bold"], " ", "=", " ", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
          SubscriptBox["k", "out"]}]], 
        RowBox[{"-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], 
        RowBox[{"-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "0"},
       {
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         SubscriptBox["k", "out"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}], 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "0"},
       {"0", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
          SubscriptBox["k", "in"]}]], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
          SubscriptBox["k", "in"]}]], 
        RowBox[{"-", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}]},
       {"0", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         SubscriptBox["k", "out"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}]}], TraditionalForm]],
  ExpressionUUID->"7d08bd9d-ce42-4fbe-8799-52c1fbd9ae30"],
 ".\n \t\[FilledSmallCircle] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["v", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "11b34bfa-cd08-4d34-b5ab-daa2b751d292"],
 " es el vector que contiene a las inc\[OAcute]gnitas, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["v", "\[RightVector]"], "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["B", "1"]},
       {
        SubscriptBox["A", "2"]},
       {
        SubscriptBox["B", "2"]},
       {
        SubscriptBox["A", "3"]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "f1261f6f-97b1-4762-8d3b-08b6a1c91b05"],
 " . \n \t\[FilledSmallCircle] ",
 Cell[BoxData[
  FormBox[
   OverscriptBox["b", "\[RightVector]"], TraditionalForm]],ExpressionUUID->
  "4ed13a51-5127-4a03-94b8-e1f8215f57f9"],
 " es el t\[EAcute]rmino inhomog\[EAcute]neo del sistema y contiene a ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "1"], TraditionalForm]],ExpressionUUID->
  "7a8aa7c9-2601-4c5f-9bf8-62ad57c77816"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["b", "\[RightVector]"], "=", 
    RowBox[{"-", 
     RowBox[{
      SubscriptBox["A", "1"], "(", "\[NoBreak]", GridBox[{
        {
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]},
        {
         RowBox[{"\[ImaginaryI]", " ", 
          SubscriptBox["k", "out"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", 
             FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
            SubscriptBox["k", "out"]}]]}]},
        {"0"},
        {"0"}
       },
       GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[0.7]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}], "\[NoBreak]", ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"3960ddc5-47b1-480b-adcd-0b7dd934ad67"],
 ".\n\nSiendo un sistema inhomog\[EAcute]neo, al despejar los coeficientes se \
obtendr\[AAcute] una soluci\[OAcute]n ",
 StyleBox["no trivial",
  FontSlant->"Italic"],
 " (no ser\[AAcute]n solo ceros)."
}], "Text",
 CellChangeTimes->{{4.0010752499033947`*^9, 4.001075995002026*^9}, {
   4.001076620542633*^9, 4.001076630888975*^9}, {4.001077526105179*^9, 
   4.001077534822049*^9}, {4.001078448411798*^9, 4.0010784484128*^9}, {
   4.001080079054737*^9, 4.0010800814657793`*^9}, {4.0010801668666363`*^9, 
   4.0010801770584593`*^9}, 4.001783765505896*^9, {4.001787116966515*^9, 
   4.001787175847925*^9}, {4.001787213468502*^9, 4.001787499465765*^9}, {
   4.001787548073016*^9, 4.00178755625659*^9}, {4.001787593018446*^9, 
   4.001787621776705*^9}, {4.0017877264358397`*^9, 4.0017877826034107`*^9}, {
   4.001788204867573*^9, 4.0017882303662663`*^9}, {4.001788320463874*^9, 
   4.001788320464159*^9}, {4.0022957135274*^9, 
