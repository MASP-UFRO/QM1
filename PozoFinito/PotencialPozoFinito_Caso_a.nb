   4.001072172294887*^9, 4.0010725163106318`*^9}, {4.001073285458036*^9, 
   4.0010733035004597`*^9}, {4.001073351751281*^9, 4.001073354800312*^9}, {
   4.001073399220488*^9, 4.0010735121072683`*^9}, {4.001073546582924*^9, 
   4.001073741964732*^9}, {4.001073803248835*^9, 4.001073805323533*^9}, {
   4.00107388363743*^9, 4.001074414984129*^9}, {4.001074446471569*^9, 
   4.0010746991033993`*^9}, {4.00107472980793*^9, 4.0010748379271727`*^9}, {
   4.001074966366784*^9, 4.001074966768981*^9}, {4.001076586751666*^9, 
   4.001076601295641*^9}, {4.001077548302705*^9, 4.001077736962504*^9}, {
   4.001080107998681*^9, 4.001080142905828*^9}, {4.001081404368012*^9, 
   4.001081480918466*^9}, {4.001081526642868*^9, 4.001081613076873*^9}, {
   4.001081647652362*^9, 4.00108169604429*^9}, {4.001084155670739*^9, 
   4.00108415567108*^9}, {4.0010842071736593`*^9, 4.001084290766377*^9}, {
   4.0010843690975*^9, 4.001084381350017*^9}, {4.001094916742216*^9, 
   4.001094921284381*^9}, {4.00144728782551*^9, 4.001447316353901*^9}, {
   4.0014502512519436`*^9, 4.0014502743990707`*^9}, 4.0014503224233303`*^9, {
   4.00178213752136*^9, 4.001782148398572*^9}, {4.00178233490238*^9, 
   4.001782337584197*^9}, {4.0017826246646*^9, 4.001782652368373*^9}, 
   4.0017834633743477`*^9, {4.0017835009787893`*^9, 
   4.001783525585814*^9}},ExpressionUUID->"d088e8c7-3bb6-4d55-b2c7-\
e3bc42821729"],

Cell[TextData[{
 StyleBox["\nCondiciones de continuidad.", "Subsection"],
 "\n\nSe impone que la funci\[OAcute]n de onda sea continua para que la \
probabilidad de encontrar a la part\[IAcute]cula en una zona no tenga vac\
\[IAcute]os f\[IAcute]sicamente inadmisibles. \n\nDado que el potencial ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "73706877-b3d1-4b8b-a310-ebae6e12c52b"],
 " es finito en todo su dominio, la derivada de la funci\[OAcute]n de onda \
tambi\[EAcute]n es continua. \n\nLos puntos \[OpenCurlyDoubleQuote]problem\
\[AAcute]ticos\[CloseCurlyDoubleQuote] son ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "L"}], "/", "2"}]}], TraditionalForm]],
  ExpressionUUID->"8c34838c-dd24-430a-a886-5c011ac64e1c"],
 ", que es donde el potencial exhibe discontinuidades y, a causa de ello, es \
tambi\[EAcute]n donde separamos la funci\[OAcute]n de onda en tramos. \
Impondremos las condiciones de continuidad en esos puntos ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "L"}], "/", "2"}]}], TraditionalForm]],
  ExpressionUUID->"857ca33e-979a-4d52-a5a7-353e4f8fce30"],
 ": \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", GridBox[{
      {
       RowBox[{
        SubsuperscriptBox["\[Psi]", "1", " "], "(", 
        RowBox[{
         RowBox[{"-", "L"}], "/", "2"}], ")"}], "=", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Psi]", "2", " "], "(", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ")"}], " "}], 
       RowBox[{"\t\t", 
        RowBox[{"\[Implies]", "\t\t"}]}], 
       RowBox[{
        RowBox[{
         SubscriptBox["A", "1"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}], "+", 
        RowBox[{
         SubscriptBox["B", "1"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}]}], "=", 
       RowBox[{
        RowBox[{
         SubscriptBox["A", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "+", 
        RowBox[{
         SubscriptBox["B", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}]},
      {
       RowBox[{
        SubsuperscriptBox["\[Psi]", "1", 
         RowBox[{" ", "\[Prime]"}]], "(", 
        RowBox[{
         RowBox[{"-", "L"}], "/", "2"}], ")"}], "=", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Psi]", "2", 
          RowBox[{" ", "\[Prime]"}]], "(", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ")"}], " "}], 
       RowBox[{"\t\t", 
        RowBox[{"\[Implies]", "\t\t"}]}], 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["A", "1"], " ", 
         SubscriptBox["k", "out"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["B", "1"], " ", 
         SubscriptBox["k", "out"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}]}], "=", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["A", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["B", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}]},
      {
       RowBox[{
        SubsuperscriptBox["\[Psi]", "2", " "], "(", 
        RowBox[{
         RowBox[{"+", "L"}], "/", "2"}], ")"}], "=", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Psi]", "3", " "], "(", 
         RowBox[{
          RowBox[{"+", "L"}], "/", "2"}], ")"}], " "}], 
       RowBox[{"\t\t", 
        RowBox[{"\[Implies]", "\t\t"}]}], 
       RowBox[{
        RowBox[{
         SubscriptBox["A", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "+", 
        RowBox[{
         SubscriptBox["B", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}], "=", 
       RowBox[{
        RowBox[{
         SubscriptBox["A", "3"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}], "+", 
        RowBox[{
         SubscriptBox["B", "3"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}]}]},
      {
       RowBox[{
        SubsuperscriptBox["\[Psi]", "2", 
         RowBox[{" ", "\[Prime]"}]], "(", 
        RowBox[{
         RowBox[{"+", "L"}], "/", "2"}], ")"}], "=", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Psi]", "3", 
          RowBox[{" ", "\[Prime]"}]], "(", 
         RowBox[{
          RowBox[{"+", "L"}], "/", "2"}], ")"}], " "}], 
       RowBox[{"\t\t", 
        RowBox[{"\[Implies]", "\t\t"}]}], 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["A", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["B", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}], "=", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["A", "3"], " ", 
         SubscriptBox["k", "out"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["B", "3"], " ", 
         SubscriptBox["k", "out"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}]}]}
     }]}], TraditionalForm]],ExpressionUUID->
  "f0a103b2-0f7f-49e4-9098-5b96fd619d33"],
 "\n\nAs\[IAcute], estas cuatro ecuaciones forman un sistema de ecuaciones \
lineales para los coeficientes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "1"], ",", 
    SubscriptBox["B", "1"], ",", 
    SubscriptBox["A", "2"], ",", 
    SubscriptBox["B", "2"], ",", 
    SubscriptBox["A", "3"], ",", 
    SubscriptBox["B", "3"]}], TraditionalForm]],ExpressionUUID->
  "fe40b937-cfe3-43d1-a3a3-3d12cb6e4c83"],
 ". Otras ecuaciones y/o condiciones adicionales se ver\[AAcute]n caso a caso."
}], "Text",
 CellChangeTimes->{{4.0010632162920933`*^9, 4.0010634229275723`*^9}, {
   4.001063647155232*^9, 4.001063659572411*^9}, {4.0010642153652687`*^9, 
