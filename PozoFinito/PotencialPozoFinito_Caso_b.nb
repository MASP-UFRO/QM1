         Selectable->False,
         StripWrapperBoxes->True]}]},
      {
       StyleBox["y",
        FontSlant->"Plain"], " ", " "},
      {
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalPsi]", "impar"], "(", 
         RowBox[{"-", "x"}], ")"}], "=", 
        RowBox[{"-", 
         RowBox[{
          SubscriptBox["\[CapitalPsi]", "impar"], "(", "x", ")"}]}]}], 
