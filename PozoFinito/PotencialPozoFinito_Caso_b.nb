   4.0018626672261353`*^9, 4.001862979416115*^9}, 4.0023162959650383`*^9, {
   4.002317384806425*^9, 4.002317404899515*^9}, 4.002317726126255*^9, {
   4.0023178271949253`*^9, 4.0023179180077*^9}, {4.002318493854231*^9, 
