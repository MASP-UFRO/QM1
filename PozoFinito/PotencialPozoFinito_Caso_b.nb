         RowBox[{
         "Use", " ", "las", " ", "energ\[IAcute]as", " ", "y", " ", 
          "construya", " ", "los", " ", 
          RowBox[{
           SubscriptBox["\[CapitalPsi]", "n"], "(", "x", ")"}], "  ", 
          StyleBox["o",
           FontSlant->"Plain"], "  ", "los", " ", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[CapitalPsi]", 
             RowBox[{"\[ScriptJ]", ",", "s"}]], "(", "x", ")"}], ".", 
           "            \t\t\t"}]}]}]}
      }], " "}]}], TraditionalForm]],ExpressionUUID->
  "99cf7d3c-136d-2c41-81d1-08eb9ddc5033"]
}], "Text",
 CellChangeTimes->{{4.0010752499033947`*^9, 4.001075995002026*^9}, {
