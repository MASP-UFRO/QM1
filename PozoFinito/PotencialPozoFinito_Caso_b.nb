 "\n\nVemos que la paridad puede aprovecharse a favor para eliminar inc\
\[OAcute]gnitas. Si bien ahora tenemos dos ramas, pares e impares, cada rama \
solo tiene 2 inc\[OAcute]gnitas en vez de 4. Incluso podemos simplificar esto \
a\[UAcute]n m\[AAcute]s al reabsorber las constantes ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "2"], TraditionalForm]],ExpressionUUID->
  "9e9164fc-89bb-9449-9ef3-80b1c732bd54"],
 " y ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "1"], TraditionalForm]],ExpressionUUID->
  "537afb32-0ddb-b547-979c-261b8e26c5e4"],
 " en nuevas constantes: \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[CapitalPsi]", "par"], "(", "x", ")"}], "=", 
     RowBox[{
      RowBox[{
       TagBox[GridBox[{
          {"\[Piecewise]", GridBox[{
             {
              RowBox[{
               SubscriptBox["\[ScriptCapitalB]", "par"], 
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{
                 SubscriptBox["\[Gamma]", "out"], " ", "x"}]]}], 
              RowBox[{"      ", 
               RowBox[{"x", "<", 
                RowBox[{"-", 
                 FractionBox["L", "2"]}]}]}]},
             {
              RowBox[{
               SubscriptBox["\[ScriptCapitalA]", "par"], 
               RowBox[{"cos", "(", 
                RowBox[{
                 SubsuperscriptBox["k", "in", "\[VeryThinSpace]"], "x"}], 
                ")"}]}], 
              RowBox[{
               RowBox[{"-", 
                FractionBox["L", "2"]}], "\[LessEqual]", "x", "<", 
               FractionBox["L", "2"]}]},
             {
              RowBox[{
               SubscriptBox["\[ScriptCapitalB]", "par"], 
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{
                 RowBox[{"-", 
                  SubscriptBox["\[Gamma]", "out"]}], "x"}]]}], 
              RowBox[{"        ", 
               RowBox[{
                FractionBox["L", "2"], "<", "x"}]}]}
            },
            AllowedDimensions->{2, Automatic},
            Editable->True,
            
            GridBoxAlignment->{
             "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
              "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
            
            GridBoxItemSize->{
             "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, 
              "Rows" -> {{1.}}, "RowsIndexed" -> {}},
            GridBoxSpacings->{"Columns" -> {
                Offset[0.27999999999999997`], {
                 Offset[0.84]}, 
                Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
                Offset[0.2], {
                 Offset[0.4]}, 
                Offset[0.2]}, "RowsIndexed" -> {}},
            Selectable->True]}
         },
         GridBoxAlignment->{
          "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
           "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
         GridBoxItemSize->{
          "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, 
           "Rows" -> {{1.}}, "RowsIndexed" -> {}},
         GridBoxSpacings->{"Columns" -> {
             Offset[0.27999999999999997`], {
              Offset[0.35]}, 
             Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
             Offset[0.2], {
              Offset[0.4]}, 
             Offset[0.2]}, "RowsIndexed" -> {}}],
        "Piecewise",
        DeleteWithContents->True,
        Editable->False,
        SelectWithContents->True,
        Selectable->False,
        StripWrapperBoxes->True], "\t\t\t", 
       RowBox[{
        SubscriptBox["\[CapitalPsi]", "impar"], "(", "x", ")"}]}], "=", 
      TagBox[GridBox[{
         {"\[Piecewise]", GridBox[{
            {
             RowBox[{
              RowBox[{"-", 
               SubscriptBox["\[ScriptCapitalB]", "impar"]}], 
              SuperscriptBox["\[ExponentialE]", 
               RowBox[{
                SubscriptBox["\[Gamma]", "out"], " ", "x"}]]}], 
             RowBox[{"      ", 
              RowBox[{"x", "<", 
               RowBox[{"-", 
                FractionBox["L", "2"]}]}]}]},
            {
             RowBox[{
              SubscriptBox["\[ScriptCapitalA]", "impar"], 
              RowBox[{"sin", "(", 
               RowBox[{
                SubsuperscriptBox["k", "in", "\[VeryThinSpace]"], "x"}], 
               ")"}]}], 
             RowBox[{
              RowBox[{"-", 
               FractionBox["L", "2"]}], "\[LessEqual]", "x", "<", 
              FractionBox["L", "2"]}]},
            {
             RowBox[{
              SubscriptBox["\[ScriptCapitalB]", "impar"], 
              SuperscriptBox["\[ExponentialE]", 
               RowBox[{
                RowBox[{"-", 
                 SubscriptBox["\[Gamma]", "out"]}], "x"}]]}], 
             RowBox[{"        ", 
              RowBox[{
               FractionBox["L", "2"], "<", "x"}]}]}
           },
           AllowedDimensions->{2, Automatic},
           Editable->True,
           
           GridBoxAlignment->{
            "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
             "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
           
           GridBoxItemSize->{
            "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, 
             "Rows" -> {{1.}}, "RowsIndexed" -> {}},
           GridBoxSpacings->{"Columns" -> {
