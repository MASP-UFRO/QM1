   4.0018066080778694`*^9, 4.001806791048191*^9}, {4.0018068389165554`*^9, 
   4.0018068532261353`*^9}, {4.0023161104091816`*^9, 
   4.0023161154254093`*^9}},ExpressionUUID->"d03cb3bb-f0f7-c443-941d-\
da8c664a7cfa"],

Cell[TextData[{
 "\n",
 StyleBox["Sistemas de ecuaciones y condiciones sobre la energ\[IAcute]a.", 
  "Subsubsection"],
 "\n\nAhora tendremos un sistema de ecuaciones para la rama par y otro para \
la rama impar. Incorporando tambi\[EAcute]n las modificaciones ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", 
     RowBox[{"out", " "}]], "\[Rule]", 
    RowBox[{"\[ImaginaryI]", " ", 
     SubscriptBox["\[Gamma]", "out"], " "}]}], TraditionalForm]],
  ExpressionUUID->"f93f1ba1-8fef-e74f-a263-7e2c34917aea"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["A", "1"], "\[Rule]", "0"}]}], TraditionalForm]],
  ExpressionUUID->"beca21ea-4a21-9247-b16c-7f6af2407a41"],
 " y ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["B", "3"], "\[Rule]", "0"}], TraditionalForm]],
  ExpressionUUID->"d178fd0d-065a-3b4b-acf7-c6a25dac5d8f"],
 ", tendremos\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          SubscriptBox["\[ScriptCapitalB]", "par"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}], "=", 
         RowBox[{
          SubscriptBox["\[ScriptCapitalA]", "par"], " ", 
          RowBox[{"cos", "(", 
           FractionBox[
            RowBox[{"L", " ", 
             SubscriptBox["k", "in"]}], "2"], ")"}]}]},
        {
         RowBox[{
          SubscriptBox["\[Gamma]", "out"], " ", 
          SubscriptBox["\[ScriptCapitalB]", "par"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}], "=", 
         RowBox[{
          SubscriptBox["k", "in"], " ", 
          SubscriptBox["\[ScriptCapitalA]", "par"], " ", 
          RowBox[{"sin", "(", 
           FractionBox[
            RowBox[{"L", " ", 
             SubscriptBox["k", "in"]}], "2"], ")"}]}]},
        {
         RowBox[{
          SubscriptBox["\[ScriptCapitalA]", "par"], " ", 
          RowBox[{"cos", "(", 
           FractionBox[
            RowBox[{"L", " ", 
             SubscriptBox["k", "in"]}], "2"], ")"}]}], "=", 
         RowBox[{
          SubscriptBox["\[ScriptCapitalB]", "par"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}]},
        {
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["k", "in"]}], " ", 
          SubscriptBox["\[ScriptCapitalA]", "par"], " ", 
          RowBox[{"sin", "(", 
           FractionBox[
            RowBox[{"L", " ", 
             SubscriptBox["k", "in"]}], "2"], ")"}]}], "=", 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["\[Gamma]", "out"]}], " ", 
          SubscriptBox["\[ScriptCapitalB]", "par"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}]}
       }], ")"}], "\t", 
     RowBox[{"y", "\t", "(", GridBox[{
        {
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["\[ScriptCapitalB]", "impar"]}], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}], "=", 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["\[ScriptCapitalA]", "impar"]}], " ", 
          RowBox[{"sin", "(", 
           FractionBox[
            RowBox[{"L", " ", 
             SubscriptBox["k", "in"]}], "2"], ")"}]}]},
        {
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["\[Gamma]", "out"]}], 
          SubscriptBox["\[ScriptCapitalB]", "impar"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}], "=", 
         RowBox[{
          SubscriptBox["k", "in"], 
          SubscriptBox["\[ScriptCapitalA]", "impar"], " ", 
          RowBox[{"cos", "(", 
           FractionBox[
            RowBox[{"L", " ", 
             SubscriptBox["k", "in"]}], "2"], ")"}]}]},
        {
         RowBox[{
          SubscriptBox["\[ScriptCapitalA]", "impar"], " ", 
          RowBox[{"sin", "(", 
           FractionBox[
            RowBox[{"L", " ", 
             SubscriptBox["k", "in"]}], "2"], ")"}]}], "=", 
         RowBox[{
          SubscriptBox["\[ScriptCapitalB]", "impar"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}]},
        {
         RowBox[{
          SubscriptBox["k", "in"], 
          SubscriptBox["\[ScriptCapitalA]", "impar"], 
          RowBox[{"cos", "(", 
           FractionBox[
            RowBox[{"L", " ", 
             SubscriptBox["k", "in"]}], "2"], ")"}]}], "=", 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["\[Gamma]", "out"]}], 
          SubscriptBox["\[ScriptCapitalB]", "impar"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}]}
       }], ")"}], "\t"}]}], TraditionalForm]],ExpressionUUID->
  "eed20ed5-ae06-754c-be77-2043ea078385"],
 "\n\nEn ambas ramas se puede notar que las \[UAcute]ltimas dos ecuaciones \
son equivalentes a las dos primeras ecuaciones, de modo que los sistemas \
tienen dos ecuaciones efectivas: \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          SubscriptBox["\[ScriptCapitalA]", "par"], " ", 
          RowBox[{"cos", "(", 
           FractionBox[
            RowBox[{"L", " ", 
             SubscriptBox["k", "in"]}], "2"], ")"}]}], "=", 
         RowBox[{
          SubscriptBox["\[ScriptCapitalB]", "par"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}]},
        {
         RowBox[{
          SubscriptBox["k", "in"], " ", 
          SubscriptBox["\[ScriptCapitalA]", "par"], " ", 
          RowBox[{"sin", "(", 
           FractionBox[
            RowBox[{"L", " ", 
             SubscriptBox["k", "in"]}], "2"], ")"}]}], "=", 
         RowBox[{
          SubscriptBox["\[Gamma]", "out"], " ", 
          SubscriptBox["\[ScriptCapitalB]", "par"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}]}
       }], ")"}], "\t", 
     RowBox[{"y", "\t", "(", GridBox[{
        {
         RowBox[{
          SubscriptBox["\[ScriptCapitalA]", "impar"], " ", 
          RowBox[{"sin", "(", 
           FractionBox[
            RowBox[{"L", " ", 
             SubscriptBox["k", "in"]}], "2"], ")"}]}], "=", 
         RowBox[{
          SubscriptBox["\[ScriptCapitalB]", "impar"], " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}]},
        {
         RowBox[{
          SubscriptBox["k", "in"], " ", 
          SubscriptBox["\[ScriptCapitalA]", "impar"], " ", 
          RowBox[{"cos", "(", 
           FractionBox[
            RowBox[{"L", " ", 
             SubscriptBox["k", "in"]}], "2"], ")"}]}], "=", 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["\[Gamma]", "out"]}], " ", 
          SubscriptBox["\[ScriptCapitalB]", "impar"], 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"-", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}]}
       }], ")"}], "\t"}]}], TraditionalForm]],ExpressionUUID->
  "6fa6574d-811c-de49-b11a-9ba0b9342bee"],
 "\n\nCada sistema solo tiene dos ecuaciones y dos inc\[OAcute]gnitas. Se \
pueden representar matricialmente como ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox[
        StyleBox["M",
         FontWeight->"Bold"], "s"], "\[CenterDot]", 
       SubscriptBox[
        OverscriptBox["v", "\[RightVector]"], "s"]}], "=", 
      OverscriptBox["0", "\[RightVector]"]}], ",", "\t"}]}], 
   TraditionalForm]],ExpressionUUID->"bba47547-367d-524f-9b69-b08a9ba170d4"],
 "donde:\n\t\[FilledSmallCircle] El sub\[IAcute]ndice ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "024851d7-ed92-a546-8b4f-166c39e0dfae"],
 " denota la paridad, ",
 StyleBox["par",
  FontSlant->"Italic"],
 " o ",
 StyleBox["impar",
  FontSlant->"Italic"],
 ". \n\t    Usaremos ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "2b51d7c3-5be4-0946-a691-1a512ba2e03c"],
 " como el nombre de la paridad o como un signo ",
 Cell[BoxData[
  FormBox["\[PlusMinus]", TraditionalForm]],ExpressionUUID->
  "355f974a-6e48-a14a-8212-af5738019f4d"],
 " indistintamente. \n\t\[FilledSmallCircle] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M",
     FontWeight->"Bold"], "s"], TraditionalForm]],ExpressionUUID->
  "4ce82c8e-ce2e-ca40-a1c7-57f2737d115f"],
 " es la matriz de coeficientes, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["M",
      FontWeight->"Bold"], "par"], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]], " ", 
           RowBox[{"cos", "(", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["k", "in"]}], "2"], ")"}]}], 
          RowBox[{"-", "1"}]},
         {
          RowBox[{
           SubscriptBox["k", "in"], " ", 
           SuperscriptBox["\[ExponentialE]", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]], " ", 
           RowBox[{"sin", "(", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["k", "in"]}], "2"], ")"}]}], 
          RowBox[{"-", 
           SubscriptBox["\[Gamma]", "out"]}]}
        },
        GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.7]}, 
            Offset[0.27999999999999997`]}, "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}}], "\[NoBreak]", ")"}], "\t", 
      StyleBox["y",
       FontSlant->"Plain"], "\t", 
      SubscriptBox[
       StyleBox["M",
        FontWeight->"Bold"], "impar"]}], "=", 
     RowBox[{
      RowBox[{"(", "\[NoBreak]", GridBox[{
         {
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]], " ", 
           RowBox[{"sin", "(", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["k", "in"]}], "2"], ")"}]}], 
          RowBox[{"-", "1"}]},
         {
          RowBox[{
           SubscriptBox["k", "in"], " ", 
           SuperscriptBox["\[ExponentialE]", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["\[Gamma]", "out"]}], "2"]], " ", 
           RowBox[{"cos", "(", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["k", "in"]}], "2"], ")"}]}], 
          SubscriptBox["\[Gamma]", "out"]}
        },
        GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.7]}, 
            Offset[0.27999999999999997`]}, "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}}], "\[NoBreak]", ")"}], "."}]}]}], TraditionalForm]],
  ExpressionUUID->"fe537e2b-e7dc-564e-9aa1-4d7df4a0a9cf"],
 "\n\t\[FilledSmallCircle] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    OverscriptBox["v", "\[RightVector]"], "s"], TraditionalForm]],
  ExpressionUUID->"907655bd-056a-6e4c-94e0-3059a8b44983"],
 " es el vector que contiene a las inc\[OAcute]gnitas, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["v", "\[RightVector]"], "s"], "=", 
    RowBox[{"(", GridBox[{
       {
        SubscriptBox["\[ScriptCapitalA]", "s"]},
       {
        SubscriptBox["\[ScriptCapitalB]", "s"]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "7f1d2c4b-6c65-2542-9bce-f0232d07c7d5"],
 ".\n\nAmbos son sistemas homog\[EAcute]neos cuya soluci\[OAcute]n es ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["v", "\[RightVector]"], "s"], "=", 
    OverscriptBox["0", "\[RightVector]"]}], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"500c9091-1c2e-654a-b77f-94127c9feebc"],
 " (soluci\[OAcute]n trivial). Esta soluci\[OAcute]n es muy poco conveniente \
porque nos dice que la funci\[OAcute]n de onda, b\[AAcute]sicamente, ",
 StyleBox["no existe",
  FontSlant->"Italic"],
 ". \[DownQuestion]C\[OAcute]mo evadimos la soluci\[OAcute]n trivial? Si ",
 StyleBox["imponemos",
  FontVariations->{"Underline"->True}],
 " que el sistema de ecuaciones sea ",
 StyleBox["linealmente dependiente",
  FontSlant->"Italic"],
 ", entonces podremos escribir algunas de las inc\[OAcute]gnitas en funci\
\[OAcute]n de la otras de forma no trivial. La dependencia lineal se puede \
forzar imponiendo que \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{"det", "(", 
      SubscriptBox[
       StyleBox["M",
        FontWeight->"Bold"], "s"], ")"}], "=", "0.", "\t"}]}], 
   TraditionalForm]],ExpressionUUID->"028cd5aa-311e-ec4d-ba14-bfa358e526a8"],
 " \n\nEsto se debe a que ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"det", "(", 
     SubscriptBox[
      StyleBox["M",
       FontWeight->"Bold"], "s"], ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"53dec961-b665-6945-a067-c3cc2e634ce1"],
 " implica que ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["M",
     FontWeight->"Bold"], "s"], TraditionalForm]],ExpressionUUID->
  "8d46291a-389e-0b4b-98a5-01bd43767971"],
 " no es invertible, de modo que la ruta ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["v", "\[RightVector]"], "=", 
    RowBox[{
     RowBox[{
      SubsuperscriptBox[
       StyleBox["M",
        FontWeight->"Bold"], "s", 
       RowBox[{"-", "1"}]], "\[CenterDot]", 
      OverscriptBox["0", "\[RightVector]"]}], "=", 
     OverscriptBox["0", "\[RightVector]"]}]}], TraditionalForm]],
  ExpressionUUID->"3c0262ca-2797-014c-9ea3-0590d814522c"],
 " no ser\[IAcute]a matem\[AAcute]ticamente v\[AAcute]lida. As\[IAcute] se \
evade la soluci\[OAcute]n trivial. \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {
       RowBox[{"   ", 
        RowBox[{
         RowBox[{"Usando", " ", "operadores", " ", "l\[OAcute]gicos"}], 
         ","}]}], " ", " ", " ", " "},
      {" ", " ", " ", " ", " "},
      {
       RowBox[{"\t", 
        RowBox[{
         OverscriptBox[
          OverscriptBox[
           RowBox[{
            SubscriptBox[
             StyleBox[
              OverscriptBox["v", "\[RightVector]"],
              FontSlant->"Italic"], "s"], 
            StyleBox["\[NotEqual]",
             FontSlant->"Italic"], 
            StyleBox[
             OverscriptBox["0", "\[RightVector]"],
             FontSlant->"Plain"]}], "\[OverBrace]"], 
          RowBox[{"Queremos", ":"}]], "   ", "\[And]", "  ", 
         OverscriptBox[
          OverscriptBox[
           RowBox[{
            RowBox[{
             SubscriptBox[
              StyleBox["M",
               FontWeight->"Bold"], "s"], 
             SubscriptBox[
              StyleBox[
               OverscriptBox["v", "\[RightVector]"],
               FontSlant->"Italic"], "s"]}], "=", 
            OverscriptBox["0", "\[RightVector]"]}], "\[OverBrace]"], 
          RowBox[{"Tenemos", ":"}]], " "}]}], 
       RowBox[{"\t", 
        RowBox[{"\[DoubleLeftRightArrow]", "\t"}]}], 
       RowBox[{
        RowBox[{
         StyleBox[
          SubscriptBox[
           StyleBox[
            OverscriptBox["v", "\[RightVector]"],
            FontSlant->"Italic"], "s"],
          FontSlant->"Italic"], 
         StyleBox["\[NotEqual]",
          FontSlant->"Italic"], 
         StyleBox[
          OverscriptBox["0", "\[RightVector]"],
          FontSlant->"Plain"]}], "   ", "\[And]", " ", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           StyleBox[
            OverscriptBox["v", "\[RightVector]"],
            FontSlant->"Italic"], "s"], "=", 
          RowBox[{
           RowBox[{
            SubsuperscriptBox[
             StyleBox["M",
              FontWeight->"Bold"], "s", 
             RowBox[{"-", "1"}]], 
            OverscriptBox["0", "\[RightVector]"]}], "  ", "\[Or]", "  ", 
           RowBox[{"\[NotExists]", 
            SubsuperscriptBox[
             StyleBox["M",
              FontWeight->"Bold"], "s", 
             RowBox[{"-", "1"}]]}]}]}], ")"}]}], " ", " "},
      {" ", 
       RowBox[{"\t", 
        RowBox[{"\[DoubleLeftRightArrow]", "\t"}]}], 
       RowBox[{
        RowBox[{
         StyleBox[
          SubscriptBox[
           StyleBox[
            OverscriptBox["v", "\[RightVector]"],
            FontSlant->"Italic"], "s"],
          FontSlant->"Italic"], 
         StyleBox["\[NotEqual]",
          FontSlant->"Italic"], 
         StyleBox[
          OverscriptBox["0", "\[RightVector]"],
          FontSlant->"Plain"]}], "   ", "\[And]", " ", 
        RowBox[{"(", 
         RowBox[{
          SubscriptBox[
           StyleBox[
            OverscriptBox["v", "\[RightVector]"],
            FontSlant->"Italic"], "s"], "=", 
          RowBox[{
           RowBox[{
            OverscriptBox["0", "\[RightVector]"], "  ", "\[Or]", "  ", 
            RowBox[{"det", "(", 
             StyleBox[
              SubscriptBox[
               StyleBox["M",
                FontWeight->"Bold"], "s"],
              FontWeight->"Bold"], ")"}]}], "=", "0"}]}], ")"}]}], " ", " "},
      {" ", 
       RowBox[{"\t", 
        RowBox[{"\[DoubleLeftRightArrow]", "\t"}]}], 
       RowBox[{
        UnderscriptBox[
         UnderscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              StyleBox[
               SubscriptBox[
                StyleBox[
                 OverscriptBox["v", "\[RightVector]"],
                 FontSlant->"Italic"], "s"],
               FontSlant->"Italic"], 
              StyleBox["\[NotEqual]",
               FontSlant->"Italic"], 
              StyleBox[
               OverscriptBox["0", "\[RightVector]"],
               FontSlant->"Plain"]}], 
             StyleBox[" ",
              FontSlant->"Plain"], 
             StyleBox["\[And]",
              FontSlant->"Plain"], 
             StyleBox[" ",
              FontSlant->"Plain"], 
             StyleBox[
              SubscriptBox[
               StyleBox[
                OverscriptBox["v", "\[RightVector]"],
                FontSlant->"Italic"], "s"],
              FontSlant->"Italic"]}], 
            StyleBox["=",
             FontSlant->"Italic"], 
            StyleBox[
             OverscriptBox["0", "\[RightVector]"],
             FontSlant->"Plain"]}], 
           StyleBox[")",
            FontSlant->"Plain"]}], "\[UnderBrace]"], "Contradicci\[OAcute]n"], 
        StyleBox[" ",
         FontSlant->"Plain"], 
        StyleBox["\[Or]",
         FontSlant->"Plain"], 
        StyleBox[" ",
         FontSlant->"Plain"], 
        RowBox[{
         StyleBox["(",
          FontSlant->"Plain"], 
         RowBox[{
          RowBox[{
           RowBox[{
            StyleBox[
             SubscriptBox[
              StyleBox[
               OverscriptBox["v", "\[RightVector]"],
               FontSlant->"Italic"], "s"],
             FontSlant->"Italic"], 
            StyleBox["\[NotEqual]",
             FontSlant->"Italic"], 
            StyleBox[
             OverscriptBox["0", "\[RightVector]"],
             FontSlant->"Plain"]}], 
           StyleBox[" ",
            FontSlant->"Plain"], 
           StyleBox["\[And]",
            FontSlant->"Plain"], 
           StyleBox[" ",
            FontSlant->"Plain"], 
           StyleBox[
            RowBox[{"det", "(", 
             SubscriptBox[
              StyleBox["M",
               FontWeight->"Bold"], "s"], ")"}],
            FontSlant->"Plain"]}], 
          StyleBox["=",
           FontSlant->"Plain"], 
          StyleBox["0",
           FontSlant->"Plain"]}], 
         StyleBox[")",
          FontSlant->"Plain"]}]}], 
       RowBox[{"\t", 
        RowBox[{"\[DoubleLeftRightArrow]", "\t"}]}], 
       RowBox[{
        RowBox[{
         RowBox[{
          StyleBox[
           SubscriptBox[
            StyleBox[
             OverscriptBox["v", "\[RightVector]"],
             FontSlant->"Italic"], "s"],
           FontSlant->"Italic"], 
          StyleBox["\[NotEqual]",
           FontSlant->"Italic"], 
          StyleBox[
           OverscriptBox["0", "\[RightVector]"],
           FontSlant->"Plain"]}], 
         StyleBox[" ",
          FontSlant->"Plain"], 
         StyleBox["\[And]",
          FontSlant->"Plain"], 
         StyleBox[" ",
          FontSlant->"Plain"], 
         StyleBox[
          RowBox[{"det", "(", 
           SubscriptBox[
            StyleBox["M",
             FontWeight->"Bold"], "s"], ")"}],
          FontSlant->"Plain"]}], 
        StyleBox["=",
         FontSlant->"Plain"], 
        StyleBox["0",
         FontSlant->"Plain"]}]}
     }], ")"}], TraditionalForm]],ExpressionUUID->
  "b4b6e1cb-7139-6346-aa3c-1938764c99f8"],
 "\n\n\n",
 StyleBox["Si no hubi\[EAcute]ramos considerado la simetr\[IAcute]a de \
paridad",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 ", el sistema de ecuaciones modificado con ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", 
     RowBox[{"out", " "}]], "\[Rule]", 
    RowBox[{"\[ImaginaryI]", " ", 
     SubscriptBox["\[Gamma]", "out"], " "}]}], TraditionalForm]],
  ExpressionUUID->"af89759a-83cc-6d4e-b884-3c23793b7445"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["A", "1"], "\[Rule]", "0"}]}], TraditionalForm]],
  ExpressionUUID->"27cc1888-5585-4242-94f7-2db88b2ca682"],
 " y ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["B", "3"], "\[Rule]", "0"}], TraditionalForm]],
  ExpressionUUID->"0aafc6ac-3733-cd43-935d-1e71874cb500"],
 "  ser\[IAcute]a\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", GridBox[{
      {
       RowBox[{
        SubscriptBox["B", "1"], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"L", " ", 
            SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}], "=", 
       RowBox[{
        RowBox[{
         SubscriptBox["A", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "+", 
        RowBox[{
         SubscriptBox["B", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}]},
      {
       RowBox[{
        SubscriptBox["B", "1"], " ", 
        SubscriptBox["\[Gamma]", "out"], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"L", " ", 
            SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}], "=", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["A", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["B", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}]},
      {
       RowBox[{
        RowBox[{
         SubscriptBox["A", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "+", 
        RowBox[{
         SubscriptBox["B", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}], "=", 
       RowBox[{
        SubscriptBox["A", "3"], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"L", " ", 
            SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}]},
      {
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["A", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["B", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}], "=", 
       RowBox[{
        RowBox[{"-", 
         SubscriptBox["A", "3"]}], " ", 
        SubscriptBox["\[Gamma]", "out"], " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{"L", " ", 
            SubscriptBox["\[Gamma]", "out"]}], "2"]}]]}]}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}]}], TraditionalForm]],ExpressionUUID->
  "0824899f-0b07-4f40-8351-c120932d0c27"],
 "\n\nHay 4 ecuaciones y 4 inc\[OAcute]gnitas, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["B", "1"], ",", 
    SubscriptBox["A", "2"], ",", 
    SubscriptBox["B", "2"], ",", 
    SubscriptBox["A", "3"]}], TraditionalForm]],ExpressionUUID->
  "73744d42-aaee-0f49-9325-6c7f28db9fce"],
 ". En este caso, el sistema tambi\[EAcute]n se puede representar como",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       StyleBox["M",
        FontWeight->"Bold"], "\[CenterDot]", 
       OverscriptBox["v", "\[RightVector]"]}], "=", 
      OverscriptBox["0", "\[RightVector]"]}], ",", "\t"}]}], 
   TraditionalForm]],ExpressionUUID->"5ec68647-0240-d64e-ad31-a77a4e5f6fac"],
 "solo que los vectores y matrices ser\[AAcute]n de dimensi\[OAcute]n 4. Y \
tambi\[EAcute]n se debe imponer ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"det", "(", 
     StyleBox["M",
      FontWeight->"Bold"], ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"db83a7bf-11a0-3d47-bc67-69be81ddaad8"],
 " para evitar la soluci\[OAcute]n trivial. Al final, se llega a los mismos \
resultados que considerando la paridad, pero el camino es un poco m\[AAcute]s \
largo. "
}], "Text",
 CellChangeTimes->{{4.0010752499033947`*^9, 4.001075995002026*^9}, {
   4.001076620542633*^9, 4.001076630888975*^9}, {4.001077526105179*^9, 
   4.001077534822049*^9}, {4.001078448411798*^9, 4.0010784484128*^9}, {
   4.001080079054737*^9, 4.0010800814657793`*^9}, {4.0010801668666363`*^9, 
   4.0010801770584593`*^9}, 4.00144270368081*^9, {4.001442736432053*^9, 
   4.0014427454024754`*^9}, {4.0014531102742367`*^9, 4.0014531102742367`*^9}, 
   4.00178371434313*^9, 4.00178441424063*^9, {4.001784606255322*^9, 
   4.001785149194882*^9}, {4.001785194508582*^9, 4.001785217063332*^9}, {
   4.0017852478639708`*^9, 4.001785311696011*^9}, {4.001785351336481*^9, 
   4.001785482852846*^9}, {4.001785534706306*^9, 4.00178566138626*^9}, {
   4.001785735376011*^9, 4.0017860478971167`*^9}, {4.0017861902089663`*^9, 
   4.001786211623177*^9}, {4.001787844208253*^9, 4.0017879489963007`*^9}, {
   4.001788099326326*^9, 4.001788123468876*^9}, {4.001788155874874*^9, 
   4.001788175672205*^9}, {4.001788303192944*^9, 4.001788307177683*^9}, {
   4.001788341325032*^9, 4.001788459851384*^9}, {4.001788521885726*^9, 
   4.001788613031477*^9}, {4.001803433660364*^9, 4.0018034641997643`*^9}, {
   4.001806319716545*^9, 4.0018063201665516`*^9}, {4.001806369944912*^9, 
   4.0018063899769363`*^9}, {4.001806446715063*^9, 4.001806565384918*^9}, {
   4.0018066080778694`*^9, 4.001806791048191*^9}, {4.0018068389165554`*^9, 
   4.0018070593209934`*^9}, {4.001807300843544*^9, 4.0018073703885193`*^9}, {
   4.0018074455873623`*^9, 4.0018074819596424`*^9}, {4.0018075129120293`*^9, 
   4.001807930782879*^9}, {4.0018079874728794`*^9, 4.001808513827896*^9}, {
   4.0023162725241184`*^9, 
   4.002316274898117*^9}},ExpressionUUID->"825ccb02-f4d7-ba42-972b-\
b2687d980336"],

Cell[TextData[{
 StyleBox["\nDiscretizaci\[OAcute]n de la energ\[IAcute]a.", 
  "Subsubsection"],
 "\n\nAcabamos de ver que se necesita imponer ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"det", "(", 
     SubscriptBox[
      StyleBox["M",
       FontWeight->"Bold"], "s"], ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"2d5e38e3-2154-45bb-961c-dc73c6ffee06"],
 ". Para el sistema de ecuaciones de este caso, \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {
         RowBox[{
          RowBox[{"det", "(", 
           SubscriptBox[
            StyleBox["M",
             FontWeight->"Bold"], "par"], ")"}], "=", "0"}], 
         RowBox[{"\t", 
          RowBox[{"\[Implies]", " \t"}]}], 
         RowBox[{
          RowBox[{
           SubscriptBox["k", "in"], " ", "sin", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["k", "in"]}], "2"], ")"}]}], "\[LongEqual]", 
          RowBox[{
           SubscriptBox["\[Gamma]", "out"], " ", "cos", 
           RowBox[{"(", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["k", "in"]}], "2"], ")"}]}]}]},
        {" ", " ", " "},
        {
         RowBox[{
          RowBox[{"det", "(", 
           SubscriptBox[
            StyleBox["M",
             FontWeight->"Bold"], "impar"], ")"}], "=", "0", " "}], 
         RowBox[{"\t", 
          RowBox[{"\[Implies]", " \t"}]}], 
         RowBox[{
          RowBox[{
           SubscriptBox["\[Gamma]", "out"], " ", 
           RowBox[{"sin", "(", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["k", "in"]}], "2"], ")"}]}], "\[LongEqual]", 
          RowBox[{
           RowBox[{"-", 
            SubscriptBox["k", "in"]}], " ", 
           RowBox[{"cos", "(", 
            FractionBox[
             RowBox[{"L", " ", 
              SubscriptBox["k", "in"]}], "2"], ")"}], "   "}]}]}
       }], ")"}], "\t", ",", " ", 
     RowBox[{"donde", "\t", 
      TagBox[GridBox[{
         {"\[Piecewise]", GridBox[{
            {
             RowBox[{
              SubscriptBox["k", "in"], "=", 
              SqrtBox[
               RowBox[{
                FractionBox[
                 RowBox[{"2", "m"}], 
                 SuperscriptBox["\[HBar]", "2"]], 
                "\[CapitalDelta]\[ScriptCapitalE]"}]]}], ","},
            {
             RowBox[{
              SubscriptBox["\[Gamma]", "out"], "=", 
              SqrtBox[
               RowBox[{
                FractionBox[
                 RowBox[{"2", "m"}], 
                 SuperscriptBox["\[HBar]", "2"]], 
                RowBox[{"(", 
                 RowBox[{
                 "\[CapitalDelta]V", "-", 
                  "\[CapitalDelta]\[ScriptCapitalE]"}], ")"}]}]]}], "."}
           },
           AllowedDimensions->{2, Automatic},
           Editable->True,
           
           GridBoxAlignment->{
            "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
             "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
           
           GridBoxItemSize->{
            "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, 
             "Rows" -> {{1.}}, "RowsIndexed" -> {}},
           GridBoxSpacings->{"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.84]}, 
               Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}, "RowsIndexed" -> {}},
           Selectable->True]}
        },
        GridBoxAlignment->{
         "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
        GridBoxItemSize->{
         "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}},
           "RowsIndexed" -> {}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.35]}, 
            Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, 
          "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}, "RowsIndexed" -> {}}],
       "Piecewise",
       DeleteWithContents->True,
       Editable->False,
       SelectWithContents->True,
       Selectable->False,
       StripWrapperBoxes->True]}]}]}], TraditionalForm]],ExpressionUUID->
  "a954c158-31c5-4f19-ac88-c66864c68d76"],
 "\n\nTodos los par\[AAcute]metros que aparecen en esta imposici\[OAcute]n se \
pueden resumir en: \n \t\[FilledSmallCircle] ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "53c9d548-93de-4478-bedf-f611574eead5"],
 ", la masa de la part\[IAcute]cula. Es ",
 StyleBox["fija",
  FontVariations->{"Underline"->True}],
 ". \n \t\[FilledSmallCircle] ",
 Cell[BoxData[
  FormBox["L", TraditionalForm]],ExpressionUUID->
  "cfcfad53-5938-4ad1-b82f-a9d0173b2d3e"],
 ", el ancho del pozo. Si bien se puede ajustar ",
 StyleBox["externamente, ",
  FontSlant->"Italic"],
 "es ",
 StyleBox["fija",
  FontVariations->{"Underline"->True}],
 " para un pozo dado.",
 StyleBox["\n ",
  FontSlant->"Italic"],
 "  \t\[FilledSmallCircle] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]V", "=", 
    RowBox[{
     SubscriptBox["V", "out"], "-", 
     SubscriptBox["V", "in"]}]}], TraditionalForm]],ExpressionUUID->
  "124b7339-c0e4-4dd2-9a7d-bcfc0606d789"],
 ", la profundidad del pozo. Tambi\[EAcute]n es ",
 StyleBox["fija",
  FontVariations->{"Underline"->True}],
 " para un pozo dado (y ajustable solo externamente).\n \t\
\[FilledSmallCircle] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]\[ScriptCapitalE]", "=", 
    RowBox[{"\[ScriptCapitalE]", "-", 
     SubscriptBox["V", "in"]}]}], TraditionalForm]],ExpressionUUID->
  "6b848d38-1700-414a-a13f-742b6c09ee77"],
 ", la energ\[IAcute]a de la part\[IAcute]cula por encima del fondo del pozo. \
Como ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalE]", TraditionalForm]],ExpressionUUID->
  "e8c1fe2a-3769-4b94-80a3-5287f3e22a17"],
 " es variable, ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]\[ScriptCapitalE]", TraditionalForm]],
  ExpressionUUID->"64cfe63d-6495-4753-9c0c-67602a4a067f"],
 " tambi\[EAcute]n lo es. \n\nEl ",
 StyleBox["\[UAcute]nico par\[AAcute]metro variable",
  FontSlant->"Italic",
  FontVariations->{"Underline"->True}],
 " que tiene cada ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"det", "(", 
     SubscriptBox[
      StyleBox["M",
       FontWeight->"Bold"], "s"], ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"63fd64be-5c46-4b8a-972b-ccb0d38700d2"],
 " es la ",
 StyleBox["energ\[IAcute]a",
  FontWeight->"Bold"],
 ". Es decir, los ceros de ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"det", "(", 
     SubscriptBox[
      StyleBox["M",
       FontWeight->"Bold"], "s"], ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"7ce8ead8-3304-4c89-bdd6-d4d4f160491a"],
 " constituyen un listado de restricciones sobre los posibles valores que \
puede adoptar la energ\[IAcute]a del sistema. Dado que estos ceros suelen \
aparecer en cantidades discretas, podemos decir que la energ\[IAcute]a queda \
sometida a condiciones que imponen su ",
 StyleBox["discretizaci\[OAcute]n",
  FontWeight->"Bold"],
 ". \n\n\[DownQuestion]Y si un valor espec\[IAcute]fico de energ\[IAcute]a no \
cumple con ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"det", "(", 
     StyleBox["M",
      FontWeight->"Bold"], ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"701156fb-3a50-4a4d-b3cd-75027c0df015"],
 "? Pues, dicha energ\[IAcute]a est\[AAcute] condenada a tener funciones de \
onda nula:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["M",
        FontWeight->"Bold"], "s"], "\[CenterDot]", 
      SubscriptBox[
       OverscriptBox["v", "\[RightVector]"], "s"]}], "=", 
     RowBox[{
      OverscriptBox["0", "\[RightVector]"], "\t", "\[Implies]", "\t", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"det", "(", 
            StyleBox[
             SubscriptBox[
              StyleBox["M",
               FontWeight->"Bold"], 
              StyleBox["s",
               FontWeight->"Plain"]],
             FontWeight->"Bold"], ")"}], "\[NotEqual]", "0"}], "  ", "\[And]",
           "  ", 
          SubscriptBox[
           OverscriptBox["v", "\[RightVector]"], "s"]}], "=", 
         OverscriptBox["0", "\[RightVector]"]}], ")"}], "  ", "\[Or]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"det", "(", 
          StyleBox[
           SubscriptBox[
            StyleBox["M",
             FontWeight->"Bold"], 
            StyleBox["s",
             FontWeight->"Plain"]],
           FontWeight->"Bold"], ")"}], "=", "0"}], ")"}]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"32bd9510-803c-4499-9c84-d92e50217b17"],
 ".\n \t\[FilledSmallCircle] Si la energ\[IAcute]a ",
 StyleBox["no satisface",
  FontVariations->{"Underline"->True}],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"det", "(", 
     StyleBox[
      SubscriptBox[
       StyleBox["M",
        FontWeight->"Bold"], 
       StyleBox["s",
        FontWeight->"Plain"]],
      FontWeight->"Bold"], ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"9e0ce3b4-8454-41c7-8604-1c691f9a9142"],
 ", termina forzando ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     OverscriptBox["v", "\[RightVector]"], "s"], "=", 
    OverscriptBox["0", "\[RightVector]"]}], TraditionalForm]],ExpressionUUID->
  "76b2e6a5-2f1c-43b9-bffb-940f4a0d27ec"],
 " (soluci\[OAcute]n nula). \n \t\[FilledSmallCircle] Si la energ\[IAcute]a s\
\[IAcute] cumple con ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"det", "(", 
     StyleBox[
      SubscriptBox[
       StyleBox["M",
        FontWeight->"Bold"], 
       StyleBox["s",
        FontWeight->"Plain"]],
      FontWeight->"Bold"], ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"ab0a7c9f-ce7a-4d0a-b7ee-2ae53ed534f0"],
 ", ah\[IAcute] la soluci\[OAcute]n ",
 StyleBox["podr\[IAcute]a",
  FontSlant->"Italic"],
 " no ser nula.  \n\nNo hay m\[AAcute]s opciones. La energ\[IAcute]a ",
 StyleBox["debe",
  FontWeight->"Bold"],
 " cumplir con ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"det", "(", 
     StyleBox[
      SubscriptBox[
       StyleBox["M",
        FontWeight->"Bold"], 
       StyleBox["s",
        FontWeight->"Plain"]],
      FontWeight->"Bold"], ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"d0f79af3-8913-40f0-91bf-eed70fb11be9"],
 ". Y como ahora las ecuaciones ser\[AAcute]n linealmente dependientes, se \
puede escribir los ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalB]", "s"], TraditionalForm]],ExpressionUUID->
  "d643bfba-3fd7-f742-89bb-2d80fb187307"],
 " en funci\[OAcute]n de los ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[ScriptCapitalA]", "s"], TraditionalForm]],ExpressionUUID->
  "dbf9b9ff-2521-6845-b49f-957717875d68"],
 ":\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     SubscriptBox["\[ScriptCapitalB]", "par"], "=", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[ScriptCapitalA]", "par"], 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"L", " ", 
          SubscriptBox["\[Gamma]", "out"]}], "2"]], 
       RowBox[{"cos", "(", 
        FractionBox[
         RowBox[{
          SubscriptBox["k", "in"], "L"}], "2"], ")"}], "\t", 
       StyleBox["y",
        FontSlant->"Plain"], "\t", 
       SubscriptBox["\[ScriptCapitalB]", "impar"]}], "=", 
      RowBox[{
       SubscriptBox["\[ScriptCapitalA]", "impar"], 
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{"L", " ", 
          SubscriptBox["\[Gamma]", "out"]}], "2"]], 
       RowBox[{
        RowBox[{"sin", "(", 
         FractionBox[
          RowBox[{
           SubscriptBox["k", "in"], "L"}], "2"], ")"}], " ", "."}]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"27da23bd-a0e8-1d4a-907c-2451c4f9ac64"]
}], "Text",
 CellChangeTimes->{{4.0010752499033947`*^9, 4.001075995002026*^9}, {
   4.001076620542633*^9, 4.001076630888975*^9}, {4.001077526105179*^9, 
   4.001077534822049*^9}, {4.001078448411798*^9, 4.0010784484128*^9}, {
   4.001080079054737*^9, 4.0010800814657793`*^9}, {4.0010801668666363`*^9, 
   4.0010801770584593`*^9}, 4.00144270368081*^9, {4.001442736432053*^9, 
   4.0014427680713367`*^9}, {4.0014532169052258`*^9, 4.001453296120327*^9}, {
   4.0014547602057533`*^9, 4.0014550902086678`*^9}, {4.0014551285891705`*^9, 
   4.00145518079846*^9}, {4.001455299647381*^9, 4.001455411931919*^9}, {
   4.001590136041635*^9, 4.0015903259786663`*^9}, {4.001590362625054*^9, 
   4.001590390189101*^9}, {4.001590692092045*^9, 4.001590724718543*^9}, {
   4.001590763338373*^9, 4.001590783640544*^9}, {4.001590845727627*^9, 
   4.001590847992292*^9}, {4.00159382519228*^9, 4.001593942692259*^9}, {
   4.0015939834628143`*^9, 4.0015940163584538`*^9}, 4.001595221783004*^9, {
   4.001595312051981*^9, 4.0015953911178617`*^9}, {4.0015954537885637`*^9, 
   4.001595522959075*^9}, {4.001595584205838*^9, 4.001595650831442*^9}, {
   4.001595900253512*^9, 4.001595921967413*^9}, {4.001600824418633*^9, 
   4.001600873577528*^9}, {4.0017861125572233`*^9, 4.00178612736454*^9}, {
   4.0017862196415997`*^9, 4.0017862280570993`*^9}, {4.001788477637794*^9, 
   4.001788495369825*^9}, {4.001788646403325*^9, 4.001788671441866*^9}, {
   4.0017887615944777`*^9, 4.001788798664811*^9}, {4.0017888341539392`*^9, 
   4.001788836132578*^9}, {4.001788871380783*^9, 4.001788935613584*^9}, {
   4.001789079270638*^9, 4.00178914394164*^9}, {4.001789177800308*^9, 
   4.001789339789083*^9}, {4.0017894079186974`*^9, 4.0017898868615437`*^9}, {
   4.001789929639916*^9, 4.001790007632442*^9}, {4.001790059444397*^9, 
   4.001790252024884*^9}, {4.001790327536919*^9, 4.00179066715705*^9}, {
   4.001794859732087*^9, 4.0017948923222313`*^9}, 4.001800822852165*^9, {
   4.0018008575627556`*^9, 4.0018008828257504`*^9}, {4.0018009542198887`*^9, 
   4.0018012162812614`*^9}, {4.00180127212191*^9, 4.001801298327236*^9}, {
   4.001801345757452*^9, 4.001801773391981*^9}, {4.0018018272821064`*^9, 
   4.001801902117687*^9}, {4.0018019959426575`*^9, 4.0018020192649555`*^9}, {
   4.0018020504847717`*^9, 4.0018023070997524`*^9}, {4.0018023630774765`*^9, 
   4.0018024748736076`*^9}, {4.001802928076933*^9, 4.0018031099272957`*^9}, 
   4.0018051275722885`*^9, {4.0018082567701416`*^9, 4.001808257198393*^9}, {
   4.0018085736457577`*^9, 4.001808736106407*^9}, {4.001808778607828*^9, 
   4.001808793705744*^9}, {4.001808859869789*^9, 4.001808860330694*^9}, {
   4.001871880932825*^9, 4.001871930968027*^9}, {4.00187197435347*^9, 
   4.0018720551931343`*^9}},ExpressionUUID->"d136cb04-18c9-4547-8c2d-\
4cd8ec84c5fd"],

Cell[TextData[{
 "\n",
 StyleBox["\[DownQuestion]C\[OAcute]mo determinamos las energ\[IAcute]as \
desde", "Subsubsection"],
 " ",
 StyleBox["det(", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox["M", "Subsubsection",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 StyleBox[")= 0", "Subsubsection",
  FontSlant->"Italic"],
 StyleBox["?", "Subsubsection"],
 "\n \nTenemos dos condiciones por separado, ",
 Cell[BoxData[
  FormBox[
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {GridBox[{
            {"Pares", 
             RowBox[{"      ", ":"}]}
           }], 
          RowBox[{
           RowBox[{
            SubscriptBox["k", "in"], " ", "sin", 
            RowBox[{"(", 
             FractionBox[
              RowBox[{"L", " ", 
               SubscriptBox["k", "in"]}], "2"], ")"}]}], "\[LongEqual]", 
           RowBox[{
            SubscriptBox["\[Gamma]", "out"], " ", "cos", 
            RowBox[{"(", 
             FractionBox[
              RowBox[{"L", " ", 
               SubscriptBox["k", "in"]}], "2"], ")"}]}]}]},
         {GridBox[{
            {"Impares", ":"}
           }], 
          RowBox[{
           RowBox[{
            SubscriptBox["k", "in"], " ", 
            RowBox[{"cos", "(", 
             FractionBox[
              RowBox[{"L", " ", 
               SubscriptBox["k", "in"]}], "2"], ")"}]}], "\[LongEqual]", 
           RowBox[{
            RowBox[{"-", 
             SubscriptBox["\[Gamma]", "out"]}], " ", 
            RowBox[{"sin", "(", 
             FractionBox[
              RowBox[{"L", " ", 
               SubscriptBox["k", "in"]}], "2"], ")"}]}]}]}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{
         "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
        GridBoxItemSize->{
         "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}},
           "RowsIndexed" -> {}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.84]}, 
            Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, 
          "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}, "RowsIndexed" -> {}},
        Selectable->True]}
     },
     GridBoxAlignment->{
      "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
       "RowsIndexed" -> {}},
     GridBoxItemSize->{
      "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
       "RowsIndexed" -> {}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.35]}, 
         Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}, "RowsIndexed" -> {}}],
    "Piecewise",
    DeleteWithContents->True,
    Editable->False,
    SelectWithContents->True,
    Selectable->False,
    StripWrapperBoxes->True], TraditionalForm]],ExpressionUUID->
  "6a5d4599-4e6a-c445-b08b-7e69b6a47a68"],
 " \ny en ninguna de ellas podemos despejar algebraicamente los valores de \
energ\[IAcute]a ya que ambas son ",
 StyleBox["ecuaciones trascendentales",
  FontSlant->"Italic"],
 ". Toda b\[UAcute]squeda debe ser num\[EAcute]rica. Por ello, debemos \
simplificar las expresiones e intentar usar variables adimensionales. Los par\
\[AAcute]metros auxiliares del comienzo sirven para este prop\[OAcute]sito, \
dejando ambas condiciones como\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{GridBox[{
         {"Pares", ":", 
          RowBox[{
           SqrtBox[
            RowBox[{"1", "-", "\[Eta]"}]], "cos", 
           RowBox[{"(", 
            RowBox[{"\[Pi]", " ", "\[CapitalLambda]"}], ")"}]}], "=", 
          RowBox[{
           RowBox[{
            SqrtBox["\[Eta]"], 
            RowBox[{"sin", "(", 
             RowBox[{"\[Pi]", " ", "\[CapitalLambda]"}], ")"}]}], ","}]},
         {"Impares", ":", 
          RowBox[{
           SqrtBox[
            RowBox[{"1", "-", "\[Eta]"}]], 
           RowBox[{"sin", "(", 
            RowBox[{"\[Pi]", " ", "\[CapitalLambda]"}], ")"}]}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             SqrtBox["\[Eta]"]}], 
            RowBox[{"cos", "(", 
             RowBox[{"\[Pi]", " ", "\[CapitalLambda]"}], ")"}]}], ","}]}
        }], "   \t\t", "donde", "  ", "\[CapitalLambda]"}], "=", 
      RowBox[{
       FractionBox["L", 
        RowBox[{"2", "\[Pi]"}]], 
       SqrtBox[
        FractionBox[
         RowBox[{"2", "m", " ", "\[CapitalDelta]V"}], 
         SuperscriptBox["\[HBar]", "2"]]], 
       SqrtBox["\[Eta]"]}]}], ",", "\t"}]}], TraditionalForm]],ExpressionUUID->
  "d120c643-d65d-1242-8732-3e849515dcca"],
 "\n\no bien como ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["F", "par"], "(", "\[Eta]", ")"}], "=", 
    RowBox[{
     RowBox[{"0", "   ", 
      StyleBox["y",
       FontSlant->"Plain"], "   ", 
      RowBox[{
       SubscriptBox["F", "impar"], "(", "\[Eta]", ")"}]}], "=", "0"}]}], 
   TraditionalForm]],ExpressionUUID->"d7927a3a-4062-1c40-afb7-32467827b2b6"],
 ", donde\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{GridBox[{
        {
         RowBox[{"     ", 
          RowBox[{
           SubscriptBox["F", "par"], "(", "\[Eta]", ")"}]}], "=", 
         RowBox[{
          SqrtBox[
           RowBox[{"1", "-", "\[Eta]"}]], 
          RowBox[{"cos", "(", " ", 
           RowBox[{"\[ScriptC]", " ", 
            SqrtBox["\[Eta]"]}], ")"}]}], "-", 
         RowBox[{
          SqrtBox["\[Eta]"], "sin", 
          RowBox[{"(", 
           RowBox[{"\[ScriptC]", 
            SqrtBox["\[Eta]"]}], ")"}]}], ","},
        {
         RowBox[{
          SubscriptBox["F", "impar"], 
          RowBox[{"(", "\[Eta]", ")"}]}], "=", 
         RowBox[{
          SqrtBox[
           RowBox[{"1", "-", "\[Eta]"}]], 
          RowBox[{"sin", "(", 
           RowBox[{"\[ScriptC]", 
            SqrtBox["\[Eta]"]}], ")"}]}], "+", 
         RowBox[{
          SqrtBox["\[Eta]"], "cos", 
          RowBox[{"(", 
           RowBox[{"\[ScriptC]", " ", 
            SqrtBox["\[Eta]"]}], ")"}]}], ","}
       }], "   \t\t", "siendo", "  ", "\[ScriptC]"}], "=", 
     RowBox[{
      FractionBox["L", "2"], 
      RowBox[{
       SqrtBox[
        FractionBox[
         RowBox[{"2", "m", " ", "\[CapitalDelta]V"}], 
         SuperscriptBox["\[HBar]", "2"]]], ".", "\t"}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"7e162d7d-1989-9646-be65-0abdb365db68"],
 "\n\nEstas simplificaciones nos permiten empezar la b\[UAcute]squeda. \n\n \t\
\[EmptySmallCircle] Las ecuaciones ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["F", "par"], "(", "\[Eta]", ")"}], "=", 
    RowBox[{
     RowBox[{"0", "   ", 
      StyleBox["y",
       FontSlant->"Plain"], "   ", 
      RowBox[{
       SubscriptBox["F", "impar"], "(", "\[Eta]", ")"}]}], "=", "0"}]}], 
   TraditionalForm]],ExpressionUUID->"17640de5-2c81-a747-ac36-22cd5cfbea8f"],
 " imponen condiciones sobre ",
 Cell[BoxData[
  FormBox["\[Eta]", TraditionalForm]],ExpressionUUID->
  "7fc799ef-6437-084d-aed4-aba22aa358b1"],
 " y ",
 Cell[BoxData[
  FormBox["\[CapitalLambda]", TraditionalForm]],ExpressionUUID->
  "6b00b76b-141e-6a41-9a59-880a4a05a9db"],
 ", que se grafican a continuaci\[OAcute]n:\[LineSeparator]\[LineSeparator]\t",
