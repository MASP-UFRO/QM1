21e8ac0756a4"],

Cell[TextData[{
 StyleBox["\n\[DownQuestion]Cu\[AAcute]ntos estados ligados tendr\[AAcute] el \
sistema?", "Subsubsection"],
 "\n\t\nDado que ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "\[Eta]", "\[LessEqual]", "1"}], 
   TraditionalForm]],ExpressionUUID->"9cae0c8a-062b-fd40-a120-4c4dcd9173ff"],
 ", la definici\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eta]", "=", 
    RowBox[{
     SuperscriptBox["sin", "2"], "(", "\[CurlyPhi]", ")"}]}], 
   TraditionalForm]],ExpressionUUID->"2841fa3f-73e1-f241-a95c-5256d6a65736"],
 ",  requiere ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "\[CurlyPhi]", "\[LessEqual]", 
    FractionBox["\[Pi]", "2"]}], TraditionalForm]],ExpressionUUID->
  "b462accf-4784-d940-b648-b53259567efa"],
 ". \n\n\t\[EmptySmallCircle] Como ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CurlyPhi]", "n"], "\[GreaterEqual]", "0"}], 
   TraditionalForm]],ExpressionUUID->"c3eed908-c9d3-ab4b-9b3c-8ffafbf20c0e"],
 ", los ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "a5ad7747-424c-314c-b9a8-3e298de7c539"],
 " no pueden ser negativos. \n\t\[EmptySmallCircle] Pero ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "5a99206b-530d-5b44-a2dd-4332b9f2d742"],
 " tampoco puede ser igual a cero:\n\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderscriptBox[
      UnderscriptBox[
       RowBox[{"n", "=", "0"}], "\[UnderBrace]"], 
      RowBox[{"(", GridBox[{
         {
          RowBox[{
           RowBox[{"n", " ", "par"}], ","}]},
         {
          RowBox[{
           SubscriptBox["\[CapitalPsi]", "n"], " ", "impar"}]}
        }], ")"}]], " ", "\[Implies]", " ", 
     SubscriptBox["\[CurlyPhi]", "0"]}], "=", 
    RowBox[{
     RowBox[{"0", " ", "\[Implies]", " ", 
      SubscriptBox["\[Eta]", "0"]}], "=", 
     RowBox[{
      RowBox[{"0", " ", "\[Implies]", " ", 
       SubscriptBox["k", "in"]}], "=", 
      RowBox[{
       RowBox[{"0", " ", "\[And]", " ", 
        SubscriptBox["\[Gamma]", "out"]}], "=", 
       RowBox[{"0", " ", "\[Implies]", " ", 
        UnderscriptBox[
         UnderscriptBox[
          RowBox[{
           SubscriptBox["\[CapitalPsi]", "0"], "=", "constante"}], 
          "\[UnderBrace]"], 
         RowBox[{"(", GridBox[{
            {
             RowBox[{"Funci\[OAcute]n", " ", "constante"}]},
            {
             RowBox[{
              StyleBox["e",
               FontSlant->"Plain"], " ", "impar", " ", "al", " ", "mismo", 
              " ", "tiempo"}]},
            {
             RowBox[{"solo", " ", "puede", " ", "ser", " ", 
              StyleBox["cero",
               FontWeight->"Bold"]}]}
           }], ")"}]]}]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "dc7a06ab-0b2b-2e47-a946-56ef263f34bf"],
 "\n\t\[EmptySmallCircle] Por lo tanto, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[GreaterEqual]", "1"}], TraditionalForm]],ExpressionUUID->
  "e49071fa-3fd6-1c40-a9a0-327ca4aebd93"],
 ". Ahora nos falta una cota superior para ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "e12ed624-c5dd-014c-b51a-d86bf940594b"],
 ".\n\t\[EmptySmallCircle] Los ceros est\[AAcute]n en  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CurlyPhi]", "n"], "+", 
     RowBox[{"\[ScriptC]", " ", 
      RowBox[{"sin", "(", 
       SubscriptBox["\[CurlyPhi]", "n"], ")"}]}]}], "=", 
    RowBox[{"n", 
     FractionBox["\[Pi]", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "1dfd84e3-57b3-da49-9bcd-42c269e304ae"],
 ". Equivalentemente, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", 
    RowBox[{
     FractionBox["2", "\[Pi]"], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["\[CurlyPhi]", "n"], "+", 
        RowBox[{"\[ScriptC]", " ", 
         RowBox[{"sin", "(", 
          SubscriptBox["\[CurlyPhi]", "n"], ")"}]}]}], ")"}], "."}]}]}], 
   TraditionalForm]],ExpressionUUID->"9f7d4e70-700f-7d4a-8e0f-9d43d99b98a7"],
 "\n\t\[EmptySmallCircle] Notemos que la funci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"n", "(", "\[Phi]", ")"}], "=", 
    RowBox[{
     FractionBox["2", "\[Pi]"], 
     RowBox[{"(", 
      RowBox[{"\[Phi]", "+", 
       RowBox[{"\[ScriptC]", " ", 
        RowBox[{"sin", "(", "\[Phi]", ")"}]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"bf83beeb-4ede-ed44-8e61-57a3f243cfb0"],
 " es creciente en ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[LessEqual]", "\[Phi]", "\[LessEqual]", 
    FractionBox["\[Pi]", "2"]}], TraditionalForm]],ExpressionUUID->
  "ade5352c-21d2-0d4f-9562-1b7838fb784f"],
 ", teniendo en cuenta que ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ScriptC]", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "24b5fbc9-8f42-4347-99b6-c7fc99c38331"],
 ":\[LineSeparator]\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"\[DifferentialD]", "n"}], 
       RowBox[{"\[DifferentialD]", "\[Phi]"}]], "=", 
      RowBox[{
       RowBox[{
        FractionBox["2", "\[Pi]"], 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"\[ScriptC]", " ", 
           RowBox[{"cos", "(", "\[Phi]", ")"}]}]}], ")"}]}], ">", "0"}]}], 
     ",", " \t", 
     RowBox[{
      RowBox[{"ya", " ", "que", "    ", 
       RowBox[{"cos", "(", "\[Phi]", ")"}]}], ">", 
      RowBox[{"0", "    ", "en", " ", "el", " ", 
       RowBox[{
        RowBox[{"intervalo", " ", "[", 
         RowBox[{"0", ",", 
          FractionBox["\[Pi]", "2"]}], "]"}], "."}]}]}]}]}], 
   TraditionalForm]],ExpressionUUID->"f5faabfb-f09a-1a4d-9e9f-62ed8ba3e94a"],
 " \n\t\[EmptySmallCircle] Por lo tanto, dado un valor fijo de ",
 Cell[BoxData[
  FormBox["\[ScriptC]", TraditionalForm]],ExpressionUUID->
  "25341b0b-c609-264d-ba8d-bb9d061f6745"],
 ", el m\[AAcute]ximo de ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "246a311c-474e-6849-b3b9-81f872797666"],
 " estar\[AAcute] en ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Phi]", "=", 
    RowBox[{"\[Pi]", "/", "2"}]}], TraditionalForm]],ExpressionUUID->
  "e19168c4-6f2f-7a4a-9f40-d5e807f92347"],
 ":\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     SubscriptBox["n", "max"], "=", 
     RowBox[{
      RowBox[{"n", "(", 
       RowBox[{"\[Phi]", "=", 
        FractionBox["\[Pi]", "2"]}], ")"}], "=", 
      RowBox[{
       RowBox[{
        FractionBox["2", "\[Pi]"], 
        RowBox[{"(", 
         RowBox[{
          FractionBox["\[Pi]", "2"], "+", 
          RowBox[{"\[ScriptC]", " ", 
           RowBox[{"sin", "(", 
            FractionBox["\[Pi]", "2"], ")"}]}]}], ")"}]}], " ", "=", " ", 
       RowBox[{"1", "+", 
        FractionBox[
         RowBox[{"2", "\[ScriptC]"}], "\[Pi]"]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"7a177083-29a7-aa41-bf2d-b8c2ad869cbc"],
 ". \t\n\t\[EmptySmallCircle] Pero ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "max"], TraditionalForm]],ExpressionUUID->
  "74ba5bfd-a826-9f44-93cc-eee5e05cc75c"],
 " debe ser un n\[UAcute]mero entero y ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"2", "\[ScriptC]"}], "\[Pi]"], TraditionalForm]],ExpressionUUID->
  "5bc7d25c-0ae4-1240-b241-d191a6cbbb55"],
 " puede no serlo. Podemos forzarlo como\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      SubscriptBox["n", "max"], "=", 
      RowBox[{
       RowBox[{"\[LeftDoubleBracket]", 
        RowBox[{"1", "+", 
         FractionBox[
          RowBox[{"2", "\[ScriptC]"}], "\[Pi]"]}], "\[RightDoubleBracket]"}], 
       " ", "=", 
       RowBox[{"\[LeftCeiling]", 
        FractionBox[
         RowBox[{"2", "\[ScriptC]"}], "\[Pi]"], "\[RightCeiling]"}]}]}], ",", 
     " ", 
     RowBox[{
      RowBox[{
      "donde", " ", "\[LeftDoubleBracket]", "x", "\[RightDoubleBracket]"}], 
      " ", "denota", " ", "la", " ", "parte", " ", "entera", " ", "de", " ", 
      "x", "  ", 
      StyleBox["y",
       FontSlant->"Plain"], 
      StyleBox[
       RowBox[{
        StyleBox[" ",
         FontSlant->"Plain"], " "}]], 
      RowBox[{"\[LeftCeiling]", "x", "\[RightCeiling]"}], " ", "es", " ", 
      "la", " ", "funci\[OAcute]n", " ", "techo", " ", 
      RowBox[{
       RowBox[{"(", 
        StyleBox["ceiling",
         FontSlant->"Italic"], ")"}], "."}]}]}]}], TraditionalForm]],
  ExpressionUUID->"0467acb2-a077-844a-864f-c77807ae46f2"],
 "  \t\t\n\t\n\t\[EmptySmallCircle] Con esto, concluimos que ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "\[LessEqual]", "n", "\[LessEqual]", 
    RowBox[{"\[LeftCeiling]", 
     FractionBox[
      RowBox[{"2", "\[ScriptC]"}], "\[Pi]"], "\[RightCeiling]"}]}], 
   TraditionalForm]],ExpressionUUID->"9cef6bbd-6067-8f44-9623-924ff4dcebd4"],
 " y que ",
 StyleBox["existir\[AAcute]n ",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "bnd"], "=", 
    RowBox[{"\[LeftCeiling]", 
     FractionBox[
      RowBox[{"2", "\[ScriptC]"}], "\[Pi]"], "\[RightCeiling]"}]}], 
   TraditionalForm]],
  FontWeight->"Bold",
  FontSlant->"Italic",ExpressionUUID->
  "4e0c944a-a234-ba41-a893-799483db0425"],
 StyleBox[" estados ligados",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ".\n\t\n\t\[EmptySmallCircle] Para interpretar mejor este n\[UAcute]mero de \
estados ligados: \n\t\t\[Bullet] Imagine que el pozo tuviera su propia \
longitud de onda de de Broglie (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "\[CapitalDelta]V"], TraditionalForm]],
  ExpressionUUID->"693ef957-400d-0f40-bbfb-e746e806221a"],
 ") correspondiente a la energ\[IAcute]a ",
 Cell[BoxData[
  FormBox["\[CapitalDelta]V", TraditionalForm]],ExpressionUUID->
  "6fa1f671-b36f-b642-85b3-11d52fe49a1d"],
 ".\n\t\t\[Bullet] Entonces, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Lambda]", "\[CapitalDelta]V"], "=", 
     RowBox[{
      FractionBox[
       RowBox[{"2", "\[Pi]"}], 
       SubscriptBox["k", 
        RowBox[{"E", "=", "\[CapitalDelta]V"}]]], "=", 
      RowBox[{
       FractionBox[
        RowBox[{"2", "\[Pi]"}], 
        SqrtBox[
         RowBox[{"2", "m", " ", 
          RowBox[{"\[CapitalDelta]V", " ", "/", " ", 
           SuperscriptBox["\[HBar]", "2"]}]}]]], ".", " ", 
       "Equivalentemente"}]}]}], ",", " ", 
    RowBox[{
     SqrtBox[
      FractionBox[
       RowBox[{"2", "m", " ", "\[CapitalDelta]V"}], 
       SuperscriptBox["\[HBar]", "2"]]], "=", 
     FractionBox[
      RowBox[{"2", "\[Pi]"}], 
      SubscriptBox["\[Lambda]", "\[CapitalDelta]V"]]}]}], TraditionalForm]],
  ExpressionUUID->"7aae4f9d-4784-754d-851e-4a92b1accc7e"],
 ".\n\t\t\[Bullet] En consecuencia, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "bnd"], "=", 
    RowBox[{
     RowBox[{"\[LeftCeiling]", 
      FractionBox[
       RowBox[{"2", "\[ScriptC]"}], "\[Pi]"], "\[RightCeiling]"}], "=", 
     RowBox[{
      RowBox[{"\[LeftCeiling]", 
       RowBox[{
        FractionBox["2", "\[Pi]"], 
        FractionBox["L", "2"], 
        SqrtBox[
         FractionBox[
          RowBox[{"2", "m", " ", "\[CapitalDelta]V"}], 
          SuperscriptBox["\[HBar]", "2"]]]}], "\[RightCeiling]"}], "=", 
      RowBox[{
       RowBox[{"\[LeftCeiling]", 
        RowBox[{
         FractionBox["2", "\[Pi]"], 
         FractionBox["L", "2"], 
         FractionBox[
          RowBox[{"2", "\[Pi]"}], 
          SubscriptBox["\[Lambda]", "\[CapitalDelta]V"]]}], 
        "\[RightCeiling]"}], "=", 
       RowBox[{
        RowBox[{"\[LeftCeiling]", 
         FractionBox[
          RowBox[{"2", "L"}], 
          SubscriptBox["\[Lambda]", "\[CapitalDelta]V"]], "\[RightCeiling]"}],
         "=", 
        RowBox[{
         RowBox[{"\[LeftCeiling]", 
          FractionBox["L", 
           RowBox[{
            SubscriptBox["\[Lambda]", "\[CapitalDelta]V"], " ", "/", " ", 
            "2"}]], "\[RightCeiling]"}], "."}]}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"c6789284-f38c-8149-a7d1-90513d32ccf4"],
 "\n\nEste n\[UAcute]mero ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["n", "bnd"], "=", 
    RowBox[{"\[LeftCeiling]", 
     FractionBox["L", 
      RowBox[{
       SubscriptBox["\[Lambda]", "\[CapitalDelta]V"], " ", "/", " ", "2"}]], 
     "\[RightCeiling]"}]}], TraditionalForm]],ExpressionUUID->
  "5b3497d6-c83b-ad4c-ae8f-d7946b930613"],
 " nos recuerda a la relaci\[OAcute]n de arm\[OAcute]nicos en una cuerda de \
guitarra: los arm\[OAcute]nicos permitidos eran aquellos donde la longitud de \
la cuerda era un n\[UAcute]mero entero de semilongitudes de onda. \nAqu\.08\
\[IAcute] tenemos que esa raz\[OAcute]n entre el ancho del pozo y \
semilongitudes de onda de de Broglie \[OpenCurlyDoubleQuote]del pozo\
\[CloseCurlyDoubleQuote] es quien nos dice cu\[AAcute]ntos estados ligados \
habr\[AAcute].\n\n\n\n",
 StyleBox["* Para ver los gr\[AAcute]ficos interactivos, ejecute la siguiente \
celda y vaya al final del archivo. ",
  FontSlant->"Italic"],
 "\t"
}], "Text",
