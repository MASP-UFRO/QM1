   4.0018152802361526`*^9}, {4.0018153403683815`*^9, 
   4.0018153468911858`*^9}, {4.0018153968999157`*^9, 4.001815441645569*^9}, {
   4.0018154814696693`*^9, 4.0018154848376884`*^9}, {4.0018155284971485`*^9, 
   4.0018155708368263`*^9}, {4.001815614641508*^9, 4.0018158046805973`*^9}, {
   4.0018158436323414`*^9, 4.001815944541765*^9}, {4.0018197140089035`*^9, 
   4.0018197165929375`*^9}, {4.001855507381626*^9, 4.0018556195203266`*^9}, {
   4.001857339069807*^9, 4.0018573717903824`*^9}, {4.0018577542761784`*^9, 
   4.0018577623496685`*^9}, {4.0018578096138687`*^9, 
   4.0018578159721603`*^9}, {4.001857847441519*^9, 4.0018579559994164`*^9}, {
   4.001858000491482*^9, 4.0018580203903904`*^9}, {4.0018580513249187`*^9, 
   4.001858219935858*^9}, {4.0018582708259964`*^9, 4.0018583912139664`*^9}, {
   4.001858474642906*^9, 4.0018587220259533`*^9}, {4.001858754075596*^9, 
   4.0018589001704025`*^9}, {4.0018589529553375`*^9, 4.001858965540146*^9}, {
   4.0018590129253025`*^9, 4.001859749460106*^9}, {4.0018598742391014`*^9, 
   4.0018603964577065`*^9}, {4.001860499506876*^9, 4.001860561370922*^9}, {
   4.0018606090279007`*^9, 4.001860798669819*^9}, {4.001861360545347*^9, 
   4.0018614155961514`*^9}, {4.001861495495882*^9, 4.001861977575138*^9}, {
