Cell[TextData[{
 StyleBox["\nCondiciones de continuidad.", "Subsection"],
 "\n\nSe impone que la funci\[OAcute]n de onda sea continua para que la \
probabilidad de encontrar a la part\[IAcute]cula en una zona no tenga vac\
\[IAcute]os f\[IAcute]sicamente inadmisibles. \n\nDado que el potencial ",
 Cell[BoxData[
  FormBox[
   RowBox[{"V", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "73706877-b3d1-4b8b-a310-ebae6e12c52b"],
 " es finito en todo su dominio, la derivada de la funci\[OAcute]n de onda \
tambi\[EAcute]n es continua. \n\nLos puntos \[OpenCurlyDoubleQuote]problem\
\[AAcute]ticos\[CloseCurlyDoubleQuote] son ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "L"}], "/", "2"}]}], TraditionalForm]],
  ExpressionUUID->"8c34838c-dd24-430a-a886-5c011ac64e1c"],
 ", que es donde el potencial exhibe discontinuidades y, a causa de ello, es \
tambi\[EAcute]n donde separamos la funci\[OAcute]n de onda en tramos. \
Impondremos las condiciones de continuidad en esos puntos ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     RowBox[{"\[PlusMinus]", "L"}], "/", "2"}]}], TraditionalForm]],
  ExpressionUUID->"857ca33e-979a-4d52-a5a7-353e4f8fce30"],
 ": \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", GridBox[{
      {
       RowBox[{
        SubsuperscriptBox["\[Psi]", "1", " "], "(", 
        RowBox[{
         RowBox[{"-", "L"}], "/", "2"}], ")"}], "=", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Psi]", "2", " "], "(", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ")"}], " "}], 
       RowBox[{"\t\t", 
        RowBox[{"\[Implies]", "\t\t"}]}], 
       RowBox[{
        RowBox[{
         SubscriptBox["A", "1"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}], "+", 
        RowBox[{
         SubscriptBox["B", "1"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}]}], "=", 
       RowBox[{
        RowBox[{
         SubscriptBox["A", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "+", 
        RowBox[{
         SubscriptBox["B", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}]},
      {
       RowBox[{
        SubsuperscriptBox["\[Psi]", "1", 
         RowBox[{" ", "\[Prime]"}]], "(", 
        RowBox[{
         RowBox[{"-", "L"}], "/", "2"}], ")"}], "=", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Psi]", "2", 
          RowBox[{" ", "\[Prime]"}]], "(", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ")"}], " "}], 
       RowBox[{"\t\t", 
        RowBox[{"\[Implies]", "\t\t"}]}], 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["A", "1"], " ", 
         SubscriptBox["k", "out"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["B", "1"], " ", 
         SubscriptBox["k", "out"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}]}], "=", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["A", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["B", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}]},
      {
       RowBox[{
        SubsuperscriptBox["\[Psi]", "2", " "], "(", 
        RowBox[{
         RowBox[{"+", "L"}], "/", "2"}], ")"}], "=", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Psi]", "3", " "], "(", 
         RowBox[{
          RowBox[{"+", "L"}], "/", "2"}], ")"}], " "}], 
       RowBox[{"\t\t", 
        RowBox[{"\[Implies]", "\t\t"}]}], 
       RowBox[{
        RowBox[{
         SubscriptBox["A", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "+", 
        RowBox[{
         SubscriptBox["B", "2"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}], "=", 
       RowBox[{
        RowBox[{
         SubscriptBox["A", "3"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}], "+", 
        RowBox[{
         SubscriptBox["B", "3"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}]}]},
      {
       RowBox[{
        SubsuperscriptBox["\[Psi]", "2", 
         RowBox[{" ", "\[Prime]"}]], "(", 
        RowBox[{
         RowBox[{"+", "L"}], "/", "2"}], ")"}], "=", 
       RowBox[{
        RowBox[{
         SubsuperscriptBox["\[Psi]", "3", 
          RowBox[{" ", "\[Prime]"}]], "(", 
         RowBox[{
          RowBox[{"+", "L"}], "/", "2"}], ")"}], " "}], 
       RowBox[{"\t\t", 
        RowBox[{"\[Implies]", "\t\t"}]}], 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["A", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["B", "2"], " ", 
         SubscriptBox["k", "in"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "in"]}]]}]}], "=", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["A", "3"], " ", 
         SubscriptBox["k", "out"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}], "-", 
        RowBox[{"\[ImaginaryI]", " ", 
         SubscriptBox["B", "3"], " ", 
         SubscriptBox["k", "out"], " ", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", "L", " ", 
           SubscriptBox["k", "out"]}]]}]}]}
     }]}], TraditionalForm]],ExpressionUUID->
  "1cd4bd1b-9b7c-4bcb-88aa-ba7ab4245d17"],
 "\n\nAs\[IAcute], estas cuatro ecuaciones forman un sistema de ecuaciones \
lineales para los coeficientes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "1"], ",", 
    SubscriptBox["B", "1"], ",", 
    SubscriptBox["A", "2"], ",", 
    SubscriptBox["B", "2"], ",", 
    SubscriptBox["A", "3"], ",", 
    SubscriptBox["B", "3"]}], TraditionalForm]],ExpressionUUID->
  "fe40b937-cfe3-43d1-a3a3-3d12cb6e4c83"],
 ". Otras ecuaciones y/o condiciones adicionales se ver\[AAcute]n caso a caso."
}], "Text",
 CellChangeTimes->{{4.0010632162920933`*^9, 4.0010634229275723`*^9}, {
   4.001063647155232*^9, 4.001063659572411*^9}, {4.0010642153652687`*^9, 
   4.00106422376053*^9}, {4.001064650649377*^9, 4.0010646925429287`*^9}, {
   4.001064732453586*^9, 4.001064755729981*^9}, {4.001068892527896*^9, 
   4.001068893237904*^9}, {4.001068949536656*^9, 4.001068952721324*^9}, {
   4.001068983047176*^9, 4.001069168779799*^9}, {4.001069207814105*^9, 
   4.001069223748796*^9}, {4.001069308862619*^9, 4.001069838098899*^9}, {
   4.0010699476870604`*^9, 4.0010703973778152`*^9}, {4.001075151363847*^9, 
   4.001075239002346*^9}, {4.0010782911874313`*^9, 4.0010782955798483`*^9}, {
   4.001080086542822*^9, 4.001080097007152*^9}, 4.0017798556218967`*^9, 
   4.001786587300963*^9, {4.001786711361269*^9, 4.0017867728292503`*^9}, {
   4.001786813625798*^9, 4.001786813625964*^9}, {4.001786857334848*^9, 
   4.0017868620721607`*^9}, 
   4.0023160845265465`*^9},ExpressionUUID->"1859a427-9961-4345-9f5c-\
c8afe6838f9f"],

Cell[TextData[{
 "\n",
 StyleBox["Caso (b): ", "Subsection"],
 StyleBox[Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "out"], ">", "\[ScriptCapitalE]", ">", 
    SubscriptBox["V", "in"]}], TraditionalForm]], "Subsection",
  FontWeight->"Plain",ExpressionUUID->"960c9133-db48-48ed-8a45-968e3654a4b4"],
   "Subsection"],
 "\n\nAqu\[IAcute] ocurrir\[AAcute] que ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      SubscriptBox["k", "1"], "=", 
      RowBox[{
       SubscriptBox["k", "3"], "=", 
       RowBox[{
        RowBox[{
         SubscriptBox["\[ImaginaryI]\[Gamma]", "out"], " \t", 
         StyleBox["y",
          FontSlant->"Plain"], " \t", 
         SubscriptBox["k", "2"]}], "=", 
        SubscriptBox["k", "in"]}]}]}], ",", " \t", 
     RowBox[{"donde", "\t", 
      TagBox[GridBox[{
         {"\[Piecewise]", GridBox[{
            {
             RowBox[{
              SubscriptBox["k", "in"], "=", 
              SqrtBox[
               RowBox[{
                FractionBox[
                 RowBox[{"2", "m"}], 
                 SuperscriptBox["\[HBar]", "2"]], 
                RowBox[{"(", 
                 RowBox[{"\[ScriptCapitalE]", "-", 
                  SubscriptBox["V", "in"]}], ")"}]}]], " "}], ","},
            {
             RowBox[{
              SubscriptBox["\[Gamma]", "out"], "=", 
              SqrtBox[
               RowBox[{
                FractionBox[
                 RowBox[{"2", "m"}], 
                 SuperscriptBox["\[HBar]", "2"]], 
                RowBox[{"(", 
                 RowBox[{
                  SubscriptBox["V", "out"], "-", "\[ScriptCapitalE]"}], 
                 ")"}]}]]}], "."}
           },
           AllowedDimensions->{2, Automatic},
           Editable->True,
           
           GridBoxAlignment->{
            "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
             "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
           
           GridBoxItemSize->{
            "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, 
             "Rows" -> {{1.}}, "RowsIndexed" -> {}},
           GridBoxSpacings->{"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.84]}, 
               Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}, "RowsIndexed" -> {}},
           Selectable->True]}
        },
        GridBoxAlignment->{
         "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
        GridBoxItemSize->{
         "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}},
           "RowsIndexed" -> {}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.35]}, 
            Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, 
          "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}, "RowsIndexed" -> {}}],
       "Piecewise",
       DeleteWithContents->True,
       Editable->False,
       SelectWithContents->True,
       Selectable->False,
       StripWrapperBoxes->True]}]}]}], TraditionalForm]],ExpressionUUID->
  "88b28741-b815-4fd5-8ebe-665ba2698726"],
 "\nEs decir, habr\[AAcute] comportamiento oscilatorio en la Regi\[OAcute]n 2 \
y comportamiento exponencial en las Regiones 1 y 3. \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", GridBox[{
      {
       SubscriptBox["\[Psi]", "1"], "=", 
       RowBox[{
        SubscriptBox["A", "1"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["\[Gamma]", "out"]}], "x"}]]}], "+", 
       RowBox[{
        SubscriptBox["B", "1"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          SubscriptBox["\[Gamma]", "out"], " ", "x"}]]}], ","},
      {
       SubscriptBox["\[Psi]", "2"], "=", 
       RowBox[{
        SubscriptBox["A", "2"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          SubsuperscriptBox["k", "in", "\[VeryThinSpace]"], "x"}]], "  "}], 
       "+", 
       RowBox[{
        SubscriptBox["B", "2"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          SubsuperscriptBox["k", "in", "\[VeryThinSpace]"], "x"}]], " "}], 
       ","},
      {
       SubscriptBox["\[Psi]", "3"], "=", 
       RowBox[{
        SubscriptBox["A", "3"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["\[Gamma]", "out"]}], "x"}]]}], "+", 
       RowBox[{
        SubscriptBox["B", "3"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          SubscriptBox["\[Gamma]", "out"], "x"}]]}], "."}
     }]}], TraditionalForm]],ExpressionUUID->
  "6da7b83a-09ed-4399-b6b0-308b70d653ed"],
 "\n\nLas exponenciales reales pueden converger asint\[OAcute]ticamente a \
cero o diverger cuando nos alejamos del origen. Considerando que ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "out"], TraditionalForm]],ExpressionUUID->
  "b8b43baf-4d72-423f-9dd5-7206220b4157"],
 " es positivo: \n \t\[FilledSmallCircle]  En la Regi\[OAcute]n 1, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", 
      SubscriptBox["\[Gamma]", "out"]}], "x"}]], TraditionalForm]],
  ExpressionUUID->"e4c0337b-ac5d-4aa4-8fe2-662afcfbd906"],
 " diverge cuando ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[Rule]", 
    RowBox[{"-", "\[Infinity]"}]}], TraditionalForm]],ExpressionUUID->
  "05a8942e-5d35-4f5f-880d-f0d88ccda684"],
 ". \n \t\[FilledSmallCircle]  En la Regi\[OAcute]n 3, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"+", 
      SubscriptBox["\[Gamma]", "out"]}], "x"}]], TraditionalForm]],
  ExpressionUUID->"b1688d21-223d-4a3a-af0c-7ade477a7104"],
 " diverge cuando ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "\[Rule]", 
    RowBox[{"+", "\[Infinity]"}]}], TraditionalForm]],ExpressionUUID->
  "d7a75d14-784a-4df2-b5f2-6f5c371ff77a"],
 ". \n\nSi imponemos de antemano que ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["A", "1"], "=", 
    RowBox[{
     SubscriptBox["B", "3"], "=", "0"}]}], TraditionalForm]],
  FontVariations->{"Underline"->False},ExpressionUUID->
  "64089fef-518b-4393-bba5-bbc943309074"],
 ", no tendremos que lidiar con ninguna de esas divergencias. Con ello, ya \
vemos que la funci\[OAcute]n de onda tendr\[AAcute] comportamiento \
oscilatorio en la Regi\[OAcute]n 2 y comportamiento ",
 StyleBox["evanescente",
  FontSlant->"Italic"],
 " en las Regiones 1 y 3:  \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", GridBox[{
      {
       SubscriptBox["\[Psi]", "1"], "=", 
       RowBox[{
        SubscriptBox["B", "1"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          SubscriptBox["\[Gamma]", "out"], " ", "x"}]]}], " ", " ", ","},
      {
       SubscriptBox["\[Psi]", "2"], "=", 
       RowBox[{
        SubscriptBox["A", "2"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          SubsuperscriptBox["k", "in", "\[VeryThinSpace]"], "x"}]], "  "}], 
       "+", 
       RowBox[{
        SubscriptBox["B", "2"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", 
          SubsuperscriptBox["k", "in", "\[VeryThinSpace]"], "x"}]], " "}], 
       ","},
      {
       SubscriptBox["\[Psi]", "3"], "=", 
       RowBox[{
        SubscriptBox["A", "3"], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", 
           SubscriptBox["\[Gamma]", "out"]}], "x"}]]}], " ", " ", "."}
     }]}], TraditionalForm]],ExpressionUUID->
  "18b8e5a7-eb1b-1e48-8db4-e90cfcc93311"],
 "\n\nTenemos un grado de ",
 StyleBox["confinamiento",
  FontWeight->"Bold"],
 ". Cuando un estado se encuentra ",
 StyleBox["confinado",
  IgnoreSpellCheck->True],
 " debido a que su energ\[IAcute]a no supera el valor del potencial salvo en \
regiones acotadas diremos que este estado es un ",
 StyleBox["estado ligado",
  FontWeight->"Bold"],
 " (",
 StyleBox["bound states",
  FontSlant->"Italic"],
 "). Los del caso (a), en cambio, suelen llamarse ",
 StyleBox["estados de scattering.\n\n",
  FontSlant->"Italic"],
 "Puede notar tambi\[EAcute]n que ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["k", "in", "2"], "+", 
     SubsuperscriptBox["\[Gamma]", "out", "2"]}], "=", 
    FractionBox[
     RowBox[{"2", "m", " ", "\[CapitalDelta]V"}], 
     SuperscriptBox["\[HBar]", "2"]]}], TraditionalForm]],ExpressionUUID->
  "a843e3b1-be9b-c244-b94a-3d044d43dd4a"]
}], "Text",
 CellChangeTimes->{{4.0010752499033947`*^9, 4.001075995002026*^9}, {
   4.001076620542633*^9, 4.001076630888975*^9}, {4.001077526105179*^9, 
   4.001077534822049*^9}, {4.001078448411798*^9, 4.0010784484128*^9}, {
   4.001080079054737*^9, 4.0010800814657793`*^9}, {4.0010801668666363`*^9, 
   4.0010801770584593`*^9}, 4.00144270368081*^9, {4.001442736432053*^9, 
   4.0014427454024754`*^9}, {4.0014531102742367`*^9, 4.0014531102742367`*^9}, 
   4.00178371434313*^9, 4.00178441424063*^9, {4.001784606255322*^9, 
   4.001785149194882*^9}, {4.001785194508582*^9, 4.001785217063332*^9}, {
   4.0017852478639708`*^9, 4.001785311696011*^9}, {4.001785351336481*^9, 
   4.001785482852846*^9}, {4.001785534706306*^9, 4.00178566138626*^9}, {
   4.001785735376011*^9, 4.0017860478971167`*^9}, {4.0017861902089663`*^9, 
   4.001786211623177*^9}, {4.001787844208253*^9, 4.0017879489963007`*^9}, {
   4.001788099326326*^9, 4.001788123468876*^9}, {4.001788155874874*^9, 
   4.001788175672205*^9}, {4.001788303192944*^9, 4.001788307177683*^9}, {
   4.001788341325032*^9, 4.001788459851384*^9}, {4.001788521885726*^9, 
   4.001788613031477*^9}, {4.001803433660364*^9, 4.0018034641997643`*^9}, {
   4.001806319716545*^9, 4.0018063201665516`*^9}, {4.001806369944912*^9, 
   4.001806376043949*^9}, {4.0018563432558403`*^9, 4.0018564293434467`*^9}, {
   4.001856459983387*^9, 4.00185646580805*^9}, {4.0018614539025974`*^9, 
   4.001861463821907*^9}, {4.0023161030930614`*^9, 4.0023161030930614`*^9}, 
   4.002317716168663*^9},ExpressionUUID->"2522700d-fc7d-4dfa-b86a-\
ed31dfb36cda"],

Cell[TextData[{
 "\n",
 StyleBox["Paridad de las eigenfunciones. ", "Subsubsection"],
 "\n\nEste pozo de potencial, en la forma en que fue definido, es una funci\
\[OAcute]n ",
 StyleBox["par",
  FontSlant->"Italic"],
 " ya que  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"V", "(", 
     RowBox[{"-", "x"}], ")"}], "=", 
    RowBox[{"V", "(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "e2c922ef-97a5-4440-8270-22cdc185ef9c"],
 ". Debido a ello, el operador hamiltoniano conmuta con el operador de \
paridad. Y nosotros sabemos que dos observables que conmuten ",
 StyleBox["pueden",
  FontSlant->"Italic"],
 " escribirse con los mismos estados propios. \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{
      RowBox[{"[", 
       RowBox[{
        OverscriptBox["H", "^"], ",", 
        OverscriptBox["\[CapitalPi]", "^"]}], "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         OverscriptBox["\[DoubleStruckCapitalO]", "^"], " \t", 
         "\[DoubleLeftRightArrow]", "\t", 
         RowBox[{"\[Exists]", 
          RowBox[{"{", 
           TemplateBox[{
             SubscriptBox["\[CapitalPsi]", "n"]},
            "Ket"], "}"}]}]}], ":", "    ", 
        RowBox[{
         OverscriptBox["H", "^"], 
         TemplateBox[{
           SubscriptBox["\[CapitalPsi]", "n"]},
          "Ket"]}]}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          SubscriptBox["\[ScriptCapitalE]", "n"], 
          TemplateBox[{
            SubscriptBox["\[CapitalPsi]", "n"]},
           "Ket"]}], "      ", "\[And]", "      ", 
         RowBox[{
          OverscriptBox["\[CapitalPi]", "^"], 
          TemplateBox[{
            SubscriptBox["\[CapitalPsi]", "n"]},
           "Ket"]}]}], "=", 
        RowBox[{
         SubscriptBox["s", "n"], 
         TemplateBox[{
           SubscriptBox["\[CapitalPsi]", "n"]},
          "Ket"]}]}]}]}], ",", "       ", 
     RowBox[{
      SubscriptBox["s", "n"], "=", 
      RowBox[{"\[PlusMinus]", "1."}]}]}]}], TraditionalForm]],ExpressionUUID->
  "695481a5-2f20-214a-b3b1-80ab360f65c6"],
 "\n\nDebido a lo anterior, las funciones de onda propias de este pozo podr\
\[AAcute]n categorizarse en eigenfunciones ",
 StyleBox["pares",
  FontSlant->"Italic"],
 " e ",
 StyleBox["impares",
  FontSlant->"Italic"],
 ". \nRecordemos que hab\[IAcute]amos construido las funciones de onda por \
tramos, \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\t", 
    RowBox[{
     RowBox[{GridBox[{
        {
         SubscriptBox["\[Psi]", "1"], "=", 
         RowBox[{
          SubscriptBox["B", "1"], 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            SubscriptBox["\[Gamma]", "out"], " ", "x"}]]}], " ", " ", ","},
        {
         SubscriptBox["\[Psi]", "2"], "=", 
         RowBox[{
          SubscriptBox["A", "2"], 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"\[ImaginaryI]", " ", 
            SubsuperscriptBox["k", "in", "\[VeryThinSpace]"], "x"}]], "  "}], 
         "+", 
         RowBox[{
          SubscriptBox["B", "2"], 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", 
            SubsuperscriptBox["k", "in", "\[VeryThinSpace]"], "x"}]], " "}], 
         ","},
        {
         SubscriptBox["\[Psi]", "3"], "=", 
         RowBox[{
          SubscriptBox["A", "3"], 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", 
             SubscriptBox["\[Gamma]", "out"]}], "x"}]]}], " ", " ", "."}
       }], "\t", GridBox[{
        {
         RowBox[{"que", " ", "tambi\[EAcute]n", " ", "podemos"}]},
        {
         RowBox[{"expresar", " ", "como"}]}
       }], "\t", 
      RowBox[{"\[CapitalPsi]", "(", "x", ")"}]}], "=", 
     TagBox[GridBox[{
        {"\[Piecewise]", GridBox[{
           {
            RowBox[{
             SubscriptBox["B", "1"], 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               SubscriptBox["\[Gamma]", "out"], " ", "x"}]]}], 
            RowBox[{"      ", 
             RowBox[{"x", "<", 
              RowBox[{"-", 
               FractionBox["L", "2"]}]}]}]},
           {
            RowBox[{
             RowBox[{
              SubscriptBox["A", "2"], 
              SuperscriptBox["\[ExponentialE]", 
               RowBox[{"\[ImaginaryI]", " ", 
                SubsuperscriptBox["k", "in", "\[VeryThinSpace]"], "x"}]]}], 
             "+", 
             RowBox[{
              SubscriptBox["B", "2"], 
              SuperscriptBox["\[ExponentialE]", 
               RowBox[{
                RowBox[{"-", "\[ImaginaryI]"}], " ", 
                SubsuperscriptBox["k", "in", "\[VeryThinSpace]"], "x"}]]}]}], 
            
            RowBox[{
             RowBox[{"-", 
              FractionBox["L", "2"]}], "\[LessEqual]", "x", "<", 
             FractionBox["L", "2"]}]},
           {
            RowBox[{
             SubscriptBox["A", "3"], 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{"-", 
                SubscriptBox["\[Gamma]", "out"]}], "x"}]]}], 
            RowBox[{"        ", 
             RowBox[{
              FractionBox["L", "2"], "<", "x"}]}]}
          },
          AllowedDimensions->{2, Automatic},
