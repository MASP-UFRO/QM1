   4.0018097480523415`*^9}, {4.0018098222802963`*^9, 4.001809824668825*^9}, {
   4.001809856341263*^9, 4.0018101090953712`*^9}, {4.0018101431847*^9, 
   4.0018102020537395`*^9}, {4.0018102563158073`*^9, 4.001810329377428*^9}, {
   4.001810385938383*^9, 4.0018104089496384`*^9}, {4.0018110707592697`*^9, 
   4.0018110833771973`*^9}, {4.001811558431219*^9, 4.0018116112383957`*^9}, {
   4.001811738790825*^9, 4.0018117575219116`*^9}, 4.0018118365926876`*^9, {
   4.0018119810967903`*^9, 4.001812539226013*^9}, {4.0018126232674236`*^9, 
