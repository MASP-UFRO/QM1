        RowBox[{"\[Implies]", "\t"}]}], 
       RowBox[{
        RowBox[{
         SubscriptBox["\[CapitalPsi]", "impar"], 
         RowBox[{"(", "x", ")"}]}], "=", 
        TagBox[GridBox[{
           {"\[Piecewise]", GridBox[{
              {
               RowBox[{
                RowBox[{"-", 
                 SubscriptBox["B", "1"]}], 
                SuperscriptBox["\[ExponentialE]", 
                 RowBox[{
                  SubscriptBox["\[Gamma]", "out"], " ", "x"}]]}], 
               RowBox[{"      ", 
                RowBox[{"x", "<", 
                 RowBox[{"-", 
