    4.001782907441083*^9, 4.001782928447054*^9}, 4.001783045717819*^9, {
    4.001783176399219*^9, 4.001783180785774*^9}, 4.001783271737363*^9, 
    4.001783311328775*^9, {4.00178341412331*^9, 4.001783419862341*^9}, {
    4.001783606365316*^9, 4.001783634760604*^9}, 4.002383791296893*^9, 
    4.002383861933118*^9, 4.0023841107494698`*^9, {4.002621745097076*^9, 
    4.0026217648676987`*^9}, {4.0026218205119553`*^9, 4.002621849905476*^9}, 
    4.002621926127713*^9, {4.002622240192463*^9, 4.002622257939035*^9}, {
    4.002623055558536*^9, 4.002623075411628*^9}, 4.0026232495211973`*^9, 
    4.0026235977114363`*^9, 4.002623758357326*^9, 4.00262383125249*^9, 
    4.002623942509365*^9, 4.002623993808406*^9, 4.002624026408387*^9, {
    4.002624129836897*^9, 4.00262418309663*^9}, 4.0026266908856897`*^9, {
    4.0026268471158524`*^9, 4.002626873083991*^9}, {4.00262691468181*^9, 
    4.002626964161378*^9}, 4.002626996928507*^9, {4.00262722391111*^9, 
    4.002627238494297*^9}, 4.002627418477541*^9, 4.002627771606248*^9, {
    4.002634868834448*^9, 4.0026349357014027`*^9}, 4.002635014200946*^9, {
    4.002635055280261*^9, 4.0026351029452333`*^9}},ExpressionUUID->
  "bd5f6a2b-27e7-4767-9a27-6d9ebf185fa2"],
 "\n\n\nLa teor\[IAcute]a general para una barrera de potencial finita tiene \
muchas similitudes con el pozo de potencial, pues la funci\[OAcute]n de onda \
tambi\[EAcute]n se debe construir como una funci\[OAcute]n con 3 tramos en \
cuyos l\[IAcute]mites se impone continuidad de la funci\[OAcute]n de onda y \
de sus derivadas: \n\t\[FilledSmallCircle]  ESIT: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["\[HBar]", "2"], 
         RowBox[{"2", "m"}]]}], 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[DifferentialD]", "2"], 
         SubscriptBox["\[Psi]", "j"]}], 
        RowBox[{"\[DifferentialD]", 
         SuperscriptBox["x", "2"]}]]}], "+", 
      RowBox[{
       SubscriptBox["V", "j"], 
       SubscriptBox["\[Psi]", "j"]}]}], "=", " ", 
     RowBox[{"\[ScriptCapitalE]", " ", 
      SubscriptBox["\[Psi]", "j"]}]}], ",", " \t", 
    RowBox[{
     RowBox[{"donde", " \t", "j"}], "=", "1"}], ",", "2", ",", "3", ",", 
    " \t", 
    RowBox[{
     SubscriptBox["V", "1"], "=", 
     RowBox[{
      SubscriptBox["V", "3"], "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["V", "out"], " \t", 
        StyleBox["y",
         FontSlant->"Plain"], "\t", 
        SubscriptBox["V", "2"]}], "=", 
       RowBox[{
        SubscriptBox["V", "in"], "."}]}]}]}]}], TraditionalForm]],
  ExpressionUUID->"777bb462-2b7f-4df1-906a-a0937c42d211"],
 " \n\t\[FilledSmallCircle]  La ESIT es equivalente a ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SubsuperscriptBox["\[Psi]", "j", "\[DoublePrime]"], "(", "x", ")"}], "+", 
      RowBox[{
       SubsuperscriptBox["k", "j", "2"], 
       RowBox[{
        SubscriptBox["\[Psi]", "j"], "(", "x", ")"}]}]}], "=", "0"}], ","}], 
   TraditionalForm]],ExpressionUUID->"65bb4825-3129-49d0-8968-348122b71fbd"],
 " donde ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "j"], "=", 
    SqrtBox[
     RowBox[{
      FractionBox[
       RowBox[{"2", "m"}], 
       SuperscriptBox["\[HBar]", "2"]], 
      RowBox[{"(", 
       RowBox[{"\[ScriptCapitalE]", "-", 
        SubscriptBox["V", "j"]}], ")"}]}]]}], TraditionalForm]],
  ExpressionUUID->"fd6cabd1-7d7e-4dad-8b33-b266b52f0f36"],
 ".\n\t\[FilledSmallCircle] Soluciones ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Psi]", "j"], "(", "x", ")"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["A", "j"], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", 
        SubscriptBox["k", "j"], "x"}]]}], "+", 
     RowBox[{
      SubscriptBox["B", "j"], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        SubscriptBox["k", "j"], "x"}]]}]}]}], TraditionalForm]],
  ExpressionUUID->"417ba8cb-645c-404e-ba30-0b7df9b6b759"],
 ", donde los ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "j"], TraditionalForm]],ExpressionUUID->
  "1b3eeaeb-2eba-460e-8b04-017652bb7c41"],
 " y ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "j"], TraditionalForm]],ExpressionUUID->
  "b6965f6c-a6ef-4c5b-b7fd-4b849c2e7d07"],
 " son inc\[OAcute]gnitas. \n\t\[FilledSmallCircle] Para resolver los \
coeficientes, imponemos continidad de ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Psi]", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "4d3ad497-5167-4211-87cd-6bb5462126c6"],
 " y ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Psi]", "'"}], 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "3d40451e-3469-47bb-9691-4afe505aae6d"],
 " para ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{"-", 
     FractionBox["L", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "22a462d5-52eb-4afc-96d6-a96bc8d9647f"],
 " y para ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{"+", 
     FractionBox["L", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "c70590b6-3b1c-47f9-9339-d436260d1741"],
 ".\n\t\[FilledSmallCircle] Par\[AAcute]metros auxiliares similares a los del \
pozo finito, con algunas diferencia:\n\t\t\t\[EmptySmallCircle] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]V", "=", 
    RowBox[{
     SubscriptBox["V", "in"], "-", 
     SubscriptBox["V", "out"]}]}], TraditionalForm]],ExpressionUUID->
  "34c68cea-9794-4740-933c-244698840336"],
 " se definir\[AAcute] como la \[OpenCurlyDoubleQuote]altura\
\[CloseCurlyDoubleQuote] de la barrera.\n\t\t\t\[EmptySmallCircle] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]\[ScriptCapitalE]", "=", 
    RowBox[{"\[ScriptCapitalE]", "-", 
     SubscriptBox["V", "out"]}]}], TraditionalForm]],ExpressionUUID->
  "f669aba4-420d-4f86-8da2-a2106cd19ea9"],
 " ser\[AAcute] cu\[AAcute]nto sobresale la energ\[IAcute]a respecto del m\
\[IAcute]nimo (afuera) del potencial.\n\t\[FilledSmallCircle] Reutilizamos \
las definiciones ",
 Cell[BoxData[
  FormBox[GridBox[{
     {"\[Eta]", "=", 
      RowBox[{"\[CapitalDelta]\[ScriptCapitalE]", "/", "\[CapitalDelta]V"}]}
    }], TraditionalForm]],ExpressionUUID->
  "f2157976-27e7-43eb-aa88-684aeb380655"],
 ",  ",
 Cell[BoxData[
  FormBox[
   FormBox[GridBox[{
      {
       SubscriptBox["\[Lambda]", "dB"], "=", 
       SqrtBox[
        FractionBox[
         RowBox[{"2", 
          SuperscriptBox["\[Pi]", "2"], 
          SuperscriptBox["\[HBar]", "2"]}], 
         RowBox[{"m", " ", "\[CapitalDelta]\[ScriptCapitalE]"}]]]}
     }],
    TraditionalForm], TraditionalForm]],ExpressionUUID->
  "860b27bd-22ed-481d-8570-99dfde69e637"],
 " y ",
 Cell[BoxData[
  FormBox[GridBox[{
     {"\[CapitalLambda]", "=", 
      RowBox[{"L", "/", 
       SubscriptBox["\[Lambda]", "dB"]}]}
    }], TraditionalForm]],ExpressionUUID->
  "75d6c18b-3ffa-493d-b06e-4bedc9cb2e9a"],
 ".\n\t\[FilledSmallCircle] Como consecuencia de las nuevas definiciones, \n\t\
\t\t\[EmptySmallCircle] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "in"], TraditionalForm]],ExpressionUUID->
  "f59196ca-37d3-4959-8b7f-878b705fc7fb"],
 " cambia a ",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      SubscriptBox["k", "in"], "=", 
      SqrtBox[
       RowBox[{
        FractionBox[
         RowBox[{"2", "m"}], 
         SuperscriptBox["\[HBar]", "2"]], 
        "\[CapitalDelta]\[ScriptCapitalE]"}]], "=", 
      RowBox[{
       SqrtBox[
        FractionBox[
         RowBox[{"2", "m", " ", "\[CapitalDelta]V"}], 
         SuperscriptBox["\[HBar]", "2"]]], 
       SqrtBox[
        RowBox[{"\[Eta]", "-", "1"}]]}]}
    }], TraditionalForm]],ExpressionUUID->
  "d5affb45-3956-47dd-bf3f-ff276cf5f040"],
 ".\n\t\t\t\[EmptySmallCircle] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "out"], TraditionalForm]],ExpressionUUID->
  "e8ef6399-4b65-4240-b8f1-ba047d4a6728"],
 " cambia a ",
 Cell[BoxData[
  FormBox[GridBox[{
     {
      SubscriptBox["k", "out"], "=", 
      SqrtBox[
       RowBox[{
        FractionBox[
         RowBox[{"2", "m"}], 
         SuperscriptBox["\[HBar]", "2"]], 
        RowBox[{"(", 
         RowBox[{
         "\[CapitalDelta]\[ScriptCapitalE]", "-", "\[CapitalDelta]V"}], 
         ")"}]}]], "=", 
      RowBox[{
       SqrtBox[
        FractionBox[
         RowBox[{"2", "m", " ", "\[CapitalDelta]V"}], 
         SuperscriptBox["\[HBar]", "2"]]], 
       SqrtBox["\[Eta]"]}]}
    }], TraditionalForm]],ExpressionUUID->
  "570f7b1a-9f8f-4299-a523-a7b5abb08e99"],
 ".\n\t\t\t\[EmptySmallCircle] Se mantiene ",
 Cell[BoxData[
  FormBox[GridBox[{
     {"\[CapitalLambda]", "=", 
      RowBox[{"L", 
       SqrtBox[
        RowBox[{
         FractionBox["m", 
          RowBox[{"2", 
           SuperscriptBox["\[Pi]", "2"], 
           SuperscriptBox["\[HBar]", "2"]}]], 
         "\[CapitalDelta]\[ScriptCapitalE]"}]]}], "=", 
      RowBox[{
       FractionBox["L", 
        RowBox[{"2", "\[Pi]"}]], 
       SqrtBox[
        FractionBox[
         RowBox[{"2", "m", " ", "\[CapitalDelta]V"}], 
         SuperscriptBox["\[HBar]", "2"]]], 
       SqrtBox["\[Eta]"]}]}
    }], TraditionalForm]],ExpressionUUID->
  "f2ba8819-f5ee-46dd-8337-16376c6cb095"],
 "."
}], "Text",
 CellChangeTimes->{{4.0010632162920933`*^9, 4.0010634229275723`*^9}, {
