   4.002632021106805*^9, 4.002632162487474*^9}, {4.002632240951098*^9, 
   4.002632344423423*^9}, {4.0026323763906*^9, 4.002632633735602*^9}, {
   4.002634721476141*^9, 4.00263472228668*^9}, {4.0026348385542603`*^9, 
   4.002634839182497*^9}, 4.0026348742517548`*^9, {4.002635130059184*^9, 
   4.002635204898061*^9}, {4.002638057561101*^9, 
   4.0026381245195723`*^9}},ExpressionUUID->"2522700d-fc7d-4dfa-b86a-\
ed31dfb36cda"],

Cell["\<\


\
\>", "Text",
 CellChangeTimes->{
  4.0010760175347443`*^9, {4.0010760839447002`*^9, 4.001076546514537*^9}, {
   4.001076639264883*^9, 4.001076687616231*^9}, {4.001076733868971*^9, 
   4.001076792454417*^9}, {4.001076822609432*^9, 4.001076845461174*^9}, {
   4.001076879408512*^9, 4.0010775091694613`*^9}, {4.001080050499467*^9, 
   4.001080073271845*^9}, {4.001080189026396*^9, 4.0010802308808603`*^9}, 
   4.001783538957652*^9, {4.001800782936943*^9, 4.0018008077181664`*^9}, {
   4.0026324828111963`*^9, 4.0026324834602957`*^9}, {4.002632582221826*^9, 
   4.002632582721189*^9}, {4.002634714752845*^9, 
   4.002634720115756*^9}},ExpressionUUID->"b6e8c787-bb25-42ac-ab3a-\
3bdc0eacfdf3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"$Assumptions", "=", 
     RowBox[{
      RowBox[{"And", "@@", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["k", "out"], ",", 
           SubscriptBox["\[CapitalKappa]", "P"], ",", 
           SubscriptBox["\[Gamma]", "in"], ",", 
           SubscriptBox["\[Gamma]", "out"], ",", "L", ",", 
           "\[ScriptCapitalL]", ",", "\[CapitalLambda]", ",", 
           SubscriptBox["\[Lambda]", "P"], ",", 
           SubscriptBox["\[Lambda]", "dB"], ",", "m", ",", "\[HBar]", ",", 
           "\[ScriptCapitalE]", ",", "\[Eta]", ",", 
           SubscriptBox["V", "in"], ",", 
           SubscriptBox["V", "out"], ",", "\[CapitalDelta]V", ",", 
           "\[CapitalDelta]\[ScriptCapitalV]", ",", 
